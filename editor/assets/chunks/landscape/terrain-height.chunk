#if __VERSION__ >= 300 && USE_INSTANCING && !LANDSCAPE_HEIGHT_UNORM
highp float fetchHeightSample(ivec2 texel, int layer) {
  highp vec2 bytes = floor(texelFetch(heightmap, ivec3(texel, layer), 0).rg * 255.0 + 0.5);
  return dot(bytes, vec2(256.0, 1.0));
}
#endif

highp float sampleHeightRegion(highp vec2 localXZ, highp vec4 region) {
#if __VERSION__ >= 300 && USE_INSTANCING
  #if LANDSCAPE_HEIGHT_UNORM
  highp vec2 tileUv = clamp((localXZ - region.xy) / max(region.z, 1e-6), vec2(0.0), vec2(1.0));
  highp float resolution = float(LANDSCAPE_TILE_RESOLUTION);
  tileUv = (tileUv * (resolution - 1.0) + 0.5) / resolution;
  return textureLod(heightmap, vec3(tileUv, region.w), 0.0).r * terrainParams.x + terrainParams.y;
  #else
  // RG stores the high/low bytes of one uint16 height, not two colors.
  // Decode before filtering: limited-precision UNORM filtering can amplify
  // rounding across a byte carry (e.g. 0x7fff -> 0x8000) into height spikes
  // when decal vertices lie between height samples on mobile GPUs.
  highp vec2 tileUv = clamp((localXZ - region.xy) / max(region.z, 1e-6), vec2(0.0), vec2(1.0));
  int lastTexel = LANDSCAPE_TILE_RESOLUTION - 1;
  highp vec2 grid = tileUv * float(lastTexel);
  ivec2 p0 = ivec2(floor(grid));
  ivec2 p1 = min(p0 + ivec2(1), ivec2(lastTexel));
  highp vec2 weight = fract(grid);
  int layer = int(region.w + 0.5);
  highp float h00 = fetchHeightSample(p0, layer);
  highp float h10 = fetchHeightSample(ivec2(p1.x, p0.y), layer);
  highp float h01 = fetchHeightSample(ivec2(p0.x, p1.y), layer);
  highp float h11 = fetchHeightSample(p1, layer);
  highp float height = mix(mix(h00, h10, weight.x), mix(h01, h11, weight.x), weight.y);
  return height / 65535.0 * terrainParams.x + terrainParams.y;
  #endif
#else
  return terrainParams.y;
#endif
}

float sampleHeight(vec2 localXZ) {
#if USE_INSTANCING
  return sampleHeightRegion(localXZ, a_tileInst);
#else
  return terrainParams.y;
#endif
}

#if __VERSION__ >= 300 && USE_INSTANCING
// Geometry and decals share this exact morph, including committed edge constraints.
// Heights are supplied separately so a decal block can reuse its corner samples.
vec4 morphTerrainVertex(vec2 grid, float height, float targetHeight) {
  float step = a_gridInst.z / 16.0;
  vec2 xz = a_gridInst.xy + grid * step;
  mat4 world;
  CCGetWorldMatrix(world);
  vec3 baseWorld = (world * vec4(xz.x, height, xz.y, 1.0)).xyz;
  vec2 range = lodMorph[int(a_gridInst.w)].xy;
  float morph = clamp((distance(morphCameraPos.xyz, baseWorld) - range.x) / max(range.y - range.x, 1e-3), 0.0, 1.0);
  vec2 collapse = vec2(morph);

  // Distance morph applies throughout the grid. At committed 2:1 boundaries,
  // the fine edge must meet the coarse lattice even if streaming is delayed.
  // Conversely, keep that coarse edge fixed while it has finer neighbors.
  int coarser = int(a_mappingInst.y + 0.5);
  int finer = int(a_mappingInst.z + 0.5);
  int edgeX = grid.x < 0.5 ? 1 : (grid.x > 15.5 ? 2 : 0);
  int edgeZ = grid.y < 0.5 ? 4 : (grid.y > 15.5 ? 8 : 0);
  if ((coarser & edgeX) != 0) {
    collapse.y = 1.0;
  } else if ((finer & edgeX) != 0) {
    collapse.y = 0.0;
  }
  if ((coarser & edgeZ) != 0) {
    collapse.x = 1.0;
  } else if ((finer & edgeZ) != 0) {
    collapse.x = 0.0;
  }
  vec2 odd = mod(grid, 2.0);
  // Interpolate endpoint heights so sliding vertices do not traverse and
  // temporarily introduce heightmap details between the two grid positions.
  // Only odd coordinates move; their collapse also includes edge constraints.
  float heightMorph = max(odd.x * collapse.x, odd.y * collapse.y);
  height = mix(height, targetHeight, heightMorph);
  xz -= odd * step * collapse;
  return vec4(xz.x, height, xz.y, morph);
}

vec4 terrainVertex(vec2 parentUV) {
  vec2 grid = floor(parentUV * 16.0 + 0.5);
  float step = a_gridInst.z / 16.0;
  vec2 xz = a_gridInst.xy + grid * step;
  vec2 targetXZ = xz - mod(grid, 2.0) * step;
  return morphTerrainVertex(grid, sampleHeight(xz), sampleHeight(targetXZ));
}
#endif
