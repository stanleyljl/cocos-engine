// Copyright (c) 2024 Xiamen Yaji Software Co., Ltd.
// Linear material composition only: no camera, lighting, fog or tone mapping.
CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: vt-compose-vs:vert
      frag: vt-compose-fs
      embeddedMacros: { LANDSCAPE_TRIPLANAR: false }
      depthStencilState:
        depthTest: false
        depthWrite: false
      rasterizerState:
        cullMode: none
      blendState:
        targets:
        - blend: false
        - blend: false
      properties:
        vtLayout: { value: [4352, 272, 8, 1] }
        materialParams: { value: [0.1, 1, 0, 0] }
        globalColorParams: { value: [1, 1, 0, 0] }
        heightBlendParams: { value: [1, 3, 2, 0] }
        # Initialized from the asset and VT composition policy before drawing.
        terrainHeightParams: { value: [0, 0, 0, 0] }
        triplanarParams: { value: [0, 0, 0, 0] }
        terrainHeightMap: { sampler: { minFilter: linear, magFilter: linear, mipFilter: none, addressU: clamp, addressV: clamp, addressW: clamp } }
        decalRegions: { value: [0, 0, 1, 0] }
        decalParams: { value: [0, 0, 0, 0] }
        decalLayerParams: { value: [0, 0, 0, 0] }
        decalIndexMap: { sampler: { minFilter: point, magFilter: point, mipFilter: none } }
        decalAlbedoMap: { sampler: { minFilter: linear, magFilter: linear, mipFilter: linear, addressU: clamp, addressV: clamp, addressW: clamp } }
        decalNormalMap: { sampler: { minFilter: linear, magFilter: linear, mipFilter: linear, addressU: clamp, addressV: clamp, addressW: clamp } }
        globalColorMap: { value: white, sampler: { minFilter: linear, magFilter: linear, mipFilter: linear, addressU: clamp, addressV: clamp, addressW: clamp } }
        normalSourceMap: { sampler: { minFilter: point, magFilter: point, mipFilter: none } }
        terrainNormalMap: { sampler: { minFilter: linear, magFilter: linear, mipFilter: none, addressU: clamp, addressV: clamp, addressW: clamp } }
        splatmap: { sampler: { minFilter: point, magFilter: point, addressU: clamp, addressV: clamp, addressW: clamp } }
        albedoHeightMap: { sampler: { minFilter: linear, magFilter: linear, mipFilter: linear, addressU: wrap, addressV: wrap, addressW: wrap } }
        normalRoughnessAOMap: { sampler: { minFilter: linear, magFilter: linear, mipFilter: linear, addressU: wrap, addressV: wrap, addressW: wrap } }
    - vert: vt-compose-vs:vert
      frag: vt-compose-fs
      propertyIndex: 0
      embeddedMacros: { LANDSCAPE_TRIPLANAR: true }
      depthStencilState:
        depthTest: false
        depthWrite: false
      rasterizerState:
        cullMode: none
      blendState:
        targets:
        - blend: false
        - blend: false
}%

CCProgram vt-compose-uniforms %{
  // Must match config::SOURCE_TILE_RESOLUTION.
  #define LANDSCAPE_TILE_RESOLUTION 129
  // Must match config::SOURCE_NORMAL_BORDER; the interior keeps the height grid.
  #define LANDSCAPE_NORMAL_BORDER 8
  uniform Constants {
    vec4 vtLayout; // atlas size, slot size, border, texture-to-clip Y sign
    vec4 materialParams[32]; // repeats/m, biome influence, unused, unused
    vec4 globalColorParams; // inverse landscape width/depth, blend strength, unused
    vec4 heightBlendParams; // strength (0 = linear), weight scale, sharpness, unused
    vec4 terrainHeightParams; // height scale/bias, fixed projection tile size, unused
    vec4 triplanarParams; // enabled, XZ-only band/source size, fade width/source size, blend sharpness
    vec4 decalRegions[512]; // config::DECAL_INSTANCE_MAX
    vec4 decalParams; // placed decal count
    vec4 decalLayerParams[32]; // config::DECAL_LIBRARY_MAX; X: modulate terrain color
  };
}%

CCProgram vt-compose-vs %{
  precision highp float;
  #include <vt-compose-uniforms>
  in vec2 a_position; // Packed XZ.
  in vec4 a_vtPage;
  in vec4 a_vtRegion;
  in vec4 a_vtSource;
  in vec4 a_vtProjection;

  out vec2 v_localXZ;
  #if __VERSION__ >= 300
  flat out vec4 v_source;
  flat out vec2 v_decalPage;
  flat out vec4 v_region;
  #if LANDSCAPE_TRIPLANAR
    flat out vec4 v_projection;
  #endif

  #else
  out vec4 v_source;
  out vec2 v_decalPage;
  #endif

  vec4 vert() {
    float count = vtLayout.x / vtLayout.y;
    #if LANDSCAPE_VT_COMPACT
      vec2 slot = vec2(0.0);
    #else
      vec2 slot = vec2(mod(a_vtPage.x, count), floor(a_vtPage.x / count));
    #endif
    vec2 atlasUv = (slot * vtLayout.y + a_position * vtLayout.y) / vtLayout.x;
    // The border evaluates real neighboring coordinates rather than duplicating
    // edge pixels. Interior uv=0/1 lies on the corresponding node boundary.
    vec2 local = (a_position * vtLayout.y - vtLayout.z) / (vtLayout.y - 2.0 * vtLayout.z);
    v_localXZ = a_vtRegion.xy + local * a_vtRegion.z;
    v_source = a_vtSource;
    v_decalPage = a_vtPage.xy;
    #if __VERSION__ >= 300
    v_region = a_vtRegion;
    #if LANDSCAPE_TRIPLANAR
      v_projection = a_vtProjection;
    #endif
    #endif
    vec2 clipPos = atlasUv * 2.0 - 1.0;
    // Texture-to-clip conversion: screenSpaceSignY * clipSpaceSignY.
    // Vulkan/GLES use +1; Metal needs -1. A screen-space flip alone is wrong.
    clipPos.y *= vtLayout.w;
    return vec4(clipPos, 0.0, 1.0);
  }
}%

CCProgram vt-compose-fs %{
  precision highp float;
  precision highp int;
  #include <vt-compose-uniforms>
  #include <common/color/gamma>
  #if __VERSION__ >= 300
  uniform highp usampler2DArray splatmap;
  uniform highp sampler2DArray terrainNormalMap;
  uniform highp sampler2DArray terrainHeightMap;
  uniform highp sampler2D normalSourceMap;
  uniform highp sampler2DArray albedoHeightMap;
  uniform highp sampler2DArray normalRoughnessAOMap;
  uniform sampler2D globalColorMap;
  uniform highp sampler2DArray decalAlbedoMap;
  uniform highp sampler2DArray decalNormalMap;
  uniform sampler2D decalIndexMap;
  in vec2 v_localXZ;
  flat in vec4 v_source;
  flat in vec2 v_decalPage;
  flat in vec4 v_region;
  #if LANDSCAPE_TRIPLANAR
    flat in vec4 v_projection;
  #endif

  layout(location = 0) out vec4 albedoOut;
  layout(location = 1) out vec4 normalOut;

  vec3 applyBiomeColor(vec3 albedo, vec3 modulation, float influence) {
    // Modulation is a signed linear gain, not a target albedo. Apply each
    // material's influence before blending so protected layers retain their color.
    return clamp(albedo * (vec3(1.0) + modulation * influence), 0.0, 1.0);
  }

  float heightBlend(float weight, float height0, float height1) {
    // Delta Force (GDC 2025, slide 66). Use the same height blending at
    // every page resolution; only the height-blending setting selects linear blending.
    float amount = clamp(heightBlendParams.x, 0.0, 1.0);
    if (amount <= 0.0 || weight <= 0.0 || weight >= 1.0) {
      return weight;
    }
    float sharpness = mix(1.0, max(heightBlendParams.z, 1.0), amount);
    // Heights are in [0,1]. This bound preserves both pure-layer endpoints
    // continuously, even when artists reduce the weight scale.
    float scale = max(mix(1.0, heightBlendParams.y, amount), 2.0 * amount + 1.0 / sharpness);
    return clamp((amount * (height1 - height0) + (weight - 0.5) * scale)
      * sharpness + 0.5, 0.0, 1.0);
  }

  vec2 normalSourceUV(vec2 xz, vec4 source) {
    // Do not clamp to the interior: VT gutters read the source's real-neighbor padding.
    vec2 pixel = (xz - source.xy) / source.z * float(LANDSCAPE_TILE_RESOLUTION - 1);
    return (pixel + float(LANDSCAPE_NORMAL_BORDER) + 0.5) / float(LANDSCAPE_TILE_RESOLUTION + 2 * LANDSCAPE_NORMAL_BORDER);
  }

  vec3 sourceNormal(vec2 xz, vec4 source) {
    vec2 n = textureLod(terrainNormalMap, vec3(normalSourceUV(xz, source), source.w), 0.0).rg * 2.0 - 1.0;
    return normalize(vec3(n.x, sqrt(max(1.0 - dot(n, n), 0.0)), n.y));
  }

  vec3 terrainTangent(vec3 n) {
    vec3 t = vec3(n.y, -n.x, 0.0);
    return dot(t, t) > 1e-10 ? normalize(t) : vec3(1.0, 0.0, 0.0);
  }

  vec3 decodeNormal(vec2 encoded) {
    vec2 xy = encoded * 2.0 - 1.0;
    return normalize(vec3(xy, sqrt(max(1.0 - dot(xy, xy), 0.0))));
  }

  struct ComposedSurface {
    vec3 albedo;
    vec3 normal;
    float roughness;
    float ao;
  };

  // Apply one decal in authored order. Rejection affects only this decal.
  void applyDecal(inout ComposedSurface surface, int index, vec2 decalDx, vec2 decalDy) {
    vec4 region = decalRegions[index];
    vec2 decalUV = (v_localXZ - region.xy) / region.z;
    // Half-open footprints give adjoining decal regions one owner at seams.
    if (any(lessThan(decalUV, vec2(0.0))) || any(greaterThanEqual(decalUV, vec2(1.0)))) {
      return;
    }
    vec2 decalGradientX = decalDx / region.z;
    vec2 decalGradientY = decalDy / region.z;
    vec3 coord = vec3(decalUV, region.w);
    vec4 color = textureGrad(decalAlbedoMap, coord, decalGradientX, decalGradientY);
    if (color.a <= 0.0) {
      return;
    }
    vec4 nra = textureGrad(decalNormalMap, coord, decalGradientX, decalGradientY);
    vec4 layer = decalLayerParams[int(region.w)];
    if (layer.y > 0.0 && layer.z > 0.0) {
      // The low-resolution decal stores coverage and a blend mask only.
      // Repeated source materials keep their own texel density in every VT page.
      int a = int(layer.y) - 1;
      int b = int(layer.z) - 1;
      vec2 local = v_localXZ - region.xy;
      float scaleA = materialParams[a].x;
      float scaleB = materialParams[b].x;
      vec3 uvA = vec3(local * scaleA, float(a));
      vec3 uvB = vec3(local * scaleB, float(b));
      vec4 ca = textureGrad(albedoHeightMap, uvA, decalDx * scaleA, decalDy * scaleA);
      vec4 cb = textureGrad(albedoHeightMap, uvB, decalDx * scaleB, decalDy * scaleB);
      vec4 na = textureGrad(normalRoughnessAOMap, uvA, decalDx * scaleA, decalDy * scaleA);
      vec4 nb = textureGrad(normalRoughnessAOMap, uvB, decalDx * scaleB, decalDy * scaleB);
      float weight = nra.b;
      color.rgb = mix(ca.rgb * ca.rgb, cb.rgb * cb.rgb, weight) * color.a;
      nra = mix(na, nb, weight);
    }
    vec3 decalNormal = decodeNormal(nra.rg);
    // Imprints darken the existing material instead of painting a solid color.
    vec3 over = surface.albedo * (1.0 - color.a) + color.rgb;
    vec3 modulated = surface.albedo * (vec3(1.0 - color.a) + color.rgb);
    surface.albedo = mix(over, modulated, layer.x);
    surface.normal = normalize(mix(surface.normal, decalNormal, color.a));
    surface.roughness = mix(surface.roughness, nra.b, color.a);
    surface.ao = mix(surface.ao, nra.a, color.a);
  }

  void applyDecals(inout ComposedSurface surface) {
    // Evaluate gradients before per-decal coverage branches.
    vec2 decalDx = dFdx(v_localXZ);
    vec2 decalDy = dFdy(v_localXZ);
    vec4 indices = vec4(0.0);
    for (int entry = 0; entry < 512; ++entry) {
      if (entry >= int(v_decalPage.y)) {
        break;
      }
      // Each texel packs two consecutive indices. Keep it for the odd entry,
      // including when the even decal is transparent or outside this pixel.
      if (entry % 2 == 0) {
        indices = texelFetch(decalIndexMap, ivec2(entry / 2, int(v_decalPage.x)), 0);
      }
      vec2 encoded = entry % 2 == 0 ? indices.rg : indices.ba;
      int index = int(dot(floor(encoded * 255.0 + 0.5), vec2(1.0, 256.0)));
      applyDecal(surface, index, decalDx, decalDy);
    }
  }

  vec3 sampleTerrainNormal() {
    // Gutters retain the nearest interior quadrant and read its padded normal tile.
    ivec2 cell = clamp(ivec2(floor((v_localXZ - v_region.xy) / v_region.z * 2.0)), ivec2(0), ivec2(1));
    vec4 source = texelFetch(normalSourceMap, ivec2(cell.y * 2 + cell.x, int(v_decalPage.x)), 0);
    return sourceNormal(v_localXZ, source);
  }

  // Three triangle corners each store a material pair. Keep those pairs for
  // height blending before spatial interpolation, even when IDs are shared.
  struct MaterialBlend {
    int layers[3];
    int sampleIndices[6];
    vec3 spatialWeights;
    vec3 pairWeights;
    vec3 weights;
  };

  MaterialBlend sampleMaterialBlend() {
    MaterialBlend blend;
    float edge = float(LANDSCAPE_TILE_RESOLUTION) - 1.0;
    vec2 pixel = clamp((v_localXZ - v_source.xy) / v_source.z * edge, vec2(0.0), vec2(edge));
    ivec2 origin = ivec2(min(floor(pixel), vec2(edge - 1.0)));
    vec2 f = pixel - vec2(origin);
    int page = int(v_source.w);
    // A--B / C--D (+X right, +Z down): B-C matches Terrain, physics and import.
    // Fetch B, C and the remaining corner A or D. Only three integer fetches.
    bool firstTriangle = f.x + f.y <= 1.0;
    ivec2 corner = firstTriangle ? origin : origin + ivec2(1, 1);
    uvec3 splatSamples = uvec3(texelFetch(splatmap, ivec3(origin + ivec2(1, 0), page), 0).r,
      texelFetch(splatmap, ivec3(origin + ivec2(0, 1), page), 0).r,
      texelFetch(splatmap, ivec3(corner, page), 0).r);
    blend.spatialWeights = firstTriangle ? vec3(f.x, f.y, 1.0-f.x-f.y)
      : vec3(1.0-f.y, 1.0-f.x, f.x+f.y-1.0);
    int ids[6];
    int minId = 31;
    int maxId = 0;
    for (int i = 0; i < 3; ++i) {
      ids[i*2] = int(splatSamples[i] & 31u);
      ids[i*2+1] = int((splatSamples[i] >> 5u) & 31u);
      minId = min(minId, min(ids[i*2], ids[i*2+1]));
      maxId = max(maxId, max(ids[i*2], ids[i*2+1]));
    }
    // Offline ID fixing guarantees <=3 distinct IDs across these six entries.
    // Extract min/mid/max without pixel-dependent top-three weight selection.
    int midId = minId;
    for (int i = 0; i < 6; ++i) {
      if (ids[i] < maxId) {
        midId = max(midId, ids[i]);
      }
    }
    blend.layers[0] = minId;
    blend.layers[1] = midId;
    blend.layers[2] = maxId;
    for (int i = 0; i < 3; ++i) {
      blend.weights[i] = 0.0;
    }
    for (int i = 0; i < 6; ++i) {
      blend.sampleIndices[i] = ids[i] == minId ? 0 : (ids[i] == maxId ? 2 : 1);
    }
    for (int i = 0; i < 3; ++i) {
      float weight = float((splatSamples[i] >> 10u) & 31u) / 31.0;
      blend.pairWeights[i] = weight;
      blend.weights[blend.sampleIndices[i*2]] += blend.spatialWeights[i] * (1.0-weight);
      blend.weights[blend.sampleIndices[i*2+1]] += blend.spatialWeights[i] * weight;
    }
    return blend;
  }

  #if LANDSCAPE_TRIPLANAR
  float sampleTerrainHeight() {
    vec2 pixel = clamp((v_localXZ - v_projection.xy) / v_projection.z, vec2(0.0), vec2(1.0)) * float(LANDSCAPE_TILE_RESOLUTION - 1);
    #if LANDSCAPE_HEIGHT_UNORM
      float height = textureLod(terrainHeightMap, vec3((pixel + 0.5) / float(LANDSCAPE_TILE_RESOLUTION), v_projection.w), 0.0).r;
    #else
      // Decode the uint16 bytes before bilinear filtering, as in terrain-height.
      ivec2 p = ivec2(floor(pixel));
      ivec2 q = min(p + ivec2(1), ivec2(LANDSCAPE_TILE_RESOLUTION - 1));
      int layer = int(v_projection.w);
      vec2 decode = vec2(256.0, 1.0) / 65535.0;
      float a = dot(floor(texelFetch(terrainHeightMap, ivec3(p, layer), 0).rg * 255.0 + 0.5), decode);
      float b = dot(floor(texelFetch(terrainHeightMap, ivec3(q.x, p.y, layer), 0).rg * 255.0 + 0.5), decode);
      float c = dot(floor(texelFetch(terrainHeightMap, ivec3(p.x, q.y, layer), 0).rg * 255.0 + 0.5), decode);
      float d = dot(floor(texelFetch(terrainHeightMap, ivec3(q, layer), 0).rg * 255.0 + 0.5), decode);
      vec2 f = fract(pixel);
      float height = mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
    #endif
    return height * terrainHeightParams.x + terrainHeightParams.y;
  }

  vec3 projectionWeights(vec3 normal) {
    // Every LOD uses the same sector grid and fixed projection source. Both sides
    // of a sector boundary are XZ-only throughout the largest page's gutter.
    vec2 distanceToEdge = abs(fract(v_localXZ / terrainHeightParams.z + 0.5) - 0.5);
    float fade = smoothstep(triplanarParams.y, triplanarParams.y + triplanarParams.z, min(distanceToEdge.x, distanceToEdge.y));
    // Unity Shader Graph Triplanar: normalized powers of the base surface normal.
    vec3 weights = pow(abs(normal), vec3(triplanarParams.w));
    weights /= dot(weights, vec3(1.0));
    return mix(vec3(0.0, 1.0, 0.0), weights, fade);
  }
  #endif

  vec4 projectedAlbedo(int layer, vec3 position, vec3 dx, vec3 dy, vec3 weights) {
    float scale = materialParams[layer].x;
    vec4 value = textureGrad(albedoHeightMap, vec3(position.xz * scale, float(layer)), dx.xz * scale, dy.xz * scale);
    value.rgb = SRGBToLinear(value.rgb);
    value *= weights.y;
    #if LANDSCAPE_TRIPLANAR
    if (weights.x > 0.0) {
      vec4 side = textureGrad(albedoHeightMap, vec3(position.zy * scale, float(layer)), dx.zy * scale, dy.zy * scale);
      side.rgb = SRGBToLinear(side.rgb);
      value += side * weights.x;
    }
    if (weights.z > 0.0) {
      vec4 side = textureGrad(albedoHeightMap, vec3(position.xy * scale, float(layer)), dx.xy * scale, dy.xy * scale);
      side.rgb = SRGBToLinear(side.rgb);
      value += side * weights.z;
    }
    #endif
    return value;
  }

  void projectedNormal(int layer, vec3 position, vec3 dx, vec3 dy, vec3 weights, vec3 normal, vec3 tangent, vec3 bitangent, out vec3 detailNormal, out vec2 roughnessAO) {
    float scale = materialParams[layer].x;
    vec4 value = textureGrad(normalRoughnessAOMap, vec3(position.xz * scale, float(layer)), dx.xz * scale, dy.xz * scale);
    vec3 detail = decodeNormal(value.rg);
    // Preserve the existing XZ tangent frame exactly in the border band and when disabled.
    detailNormal = (tangent * detail.x + bitangent * detail.y + normal * detail.z) * weights.y;
    roughnessAO = value.ba * weights.y;
    #if LANDSCAPE_TRIPLANAR
    // Projection coordinates use -Z to preserve the existing top texture orientation.
    // Reorient each side's tangent normal around the base normal before blending,
    // following Unity's Triplanar Normal mode. A neutral map reproduces the base normal.
    vec3 n = normal * vec3(1.0, 1.0, -1.0);
    if (weights.x > 0.0) {
      value = textureGrad(normalRoughnessAOMap, vec3(position.zy * scale, float(layer)), dx.zy * scale, dy.zy * scale);
      detail = decodeNormal(value.rg);
      vec3 side = vec3(n.x * detail.z, n.y + detail.y, n.z + detail.x);
      detailNormal += side * vec3(1.0, 1.0, -1.0) * weights.x;
      roughnessAO += value.ba * weights.x;
    }
    if (weights.z > 0.0) {
      value = textureGrad(normalRoughnessAOMap, vec3(position.xy * scale, float(layer)), dx.xy * scale, dy.xy * scale);
      detail = decodeNormal(value.rg);
      vec3 side = vec3(n.x + detail.x, n.y + detail.y, n.z * detail.z);
      detailNormal += side * vec3(1.0, 1.0, -1.0) * weights.z;
      roughnessAO += value.ba * weights.z;
    }
    detailNormal = normalize(detailNormal);
    #endif
  }

  void composeMaterial(MaterialBlend blend, vec3 shadingNormal, vec3 tangent, vec3 bitangent, vec3 modulation, inout ComposedSurface surface) {
    vec3 position = vec3(v_localXZ.x, 0.0, -v_localXZ.y);
    #if LANDSCAPE_TRIPLANAR
      position.y = sampleTerrainHeight();
      // Stable weights are independent of streamed shading-normal precision.
      vec3 projections = projectionWeights(sourceNormal(v_localXZ, v_projection));
    #else
      vec3 projections = vec3(0.0, 1.0, 0.0);
    #endif
    // Derivatives must precede material/axis branches for stable mip selection.
    vec3 dx = dFdx(position);
    vec3 dy = dFdy(position);
    vec3 weights = vec3(0.0);
    vec4 albedoHeights[3];
    // Blend projections before material height blending. Pure endpoints
    // cannot acquire a previously absent layer during height blending.
    for (int i = 0; i < 3; ++i) {
      albedoHeights[i] = vec4(0.0);
      if (blend.weights[i] > 0.0) {
        albedoHeights[i] = projectedAlbedo(blend.layers[i], position, dx, dy, projections);
      }
    }
    // Apply height blending to each original pair BEFORE spatial interpolation.
    // Shared vertex pairs agree across triangle edges and imported tile borders.
    for (int i = 0; i < 3; ++i) {
      int bottom = blend.sampleIndices[i*2];
      int top = blend.sampleIndices[i*2+1];
      float weight = blend.pairWeights[i];
      if (bottom != top && blend.spatialWeights[i] > 0.0) {
        weight = heightBlend(weight, albedoHeights[bottom].a, albedoHeights[top].a);
      }
      weights[bottom] += blend.spatialWeights[i] * (1.0-weight);
      weights[top] += blend.spatialWeights[i] * weight;
    }
    for (int i = 0; i < 3; ++i) {
      if (weights[i] > 0.0) {
        vec4 ah = albedoHeights[i];
        vec3 localNormal;
        vec2 roughnessAO;
        projectedNormal(blend.layers[i], position, dx, dy, projections, shadingNormal, tangent, bitangent, localNormal, roughnessAO);
        vec3 albedo = applyBiomeColor(ah.rgb, modulation, materialParams[blend.layers[i]].y);
        surface.albedo += albedo * weights[i];
        surface.normal += localNormal * weights[i];
        surface.roughness += roughnessAO.x * weights[i];
        surface.ao += roughnessAO.y * weights[i];
      }
    }
  }

  void main() {
    MaterialBlend blend = sampleMaterialBlend();
    vec3 shadingNormal = sampleTerrainNormal();
    vec3 frameTangent = terrainTangent(shadingNormal);
    vec3 frameBitangent = cross(shadingNormal, frameTangent);
    ComposedSurface surface;
    surface.albedo = vec3(0.0);
    surface.normal = vec3(0.0);
    surface.roughness = 0.0;
    surface.ao = 0.0;
    // RGB stores raw UNORM modulation data: byte 128 is exactly neutral.
    // Do not decode sRGB. Alpha is regional coverage, independent of material influence.
    // Source rows follow +Z, matching height/splat tiles and VT page borders.
    vec3 modulation = vec3(0.0);
    float biomeStrength = globalColorParams.z;
    if (biomeStrength > 0.0) {
      vec4 biome = texture(globalColorMap, v_localXZ * globalColorParams.xy);
      modulation = (biome.rgb * (255.0 / 128.0) - vec3(1.0)) * (biome.a * biomeStrength);
    }
    composeMaterial(blend, shadingNormal, frameTangent, frameBitangent, modulation, surface);
    // Blend decal normals in the terrain tangent frame, then store terrain-local normals.
    surface.normal = normalize(vec3(dot(surface.normal, frameTangent), dot(surface.normal, frameBitangent),
                                    dot(surface.normal, shadingNormal)));
    applyDecals(surface);
    surface.normal = normalize(frameTangent * surface.normal.x + frameBitangent * surface.normal.y +
                               shadingNormal * surface.normal.z);
    // Three signed components filter continuously, even when the composed
    // normal points below the horizon. Reuse the otherwise unused albedo alpha.
    // Every page uses terrain-local space, independent of its source precision.
    albedoOut = vec4(surface.albedo, surface.normal.y * 0.5 + 0.5);
    normalOut = vec4(surface.normal.xz * 0.5 + 0.5, surface.roughness, surface.ao);
  }
  #else
  void main() { gl_FragColor = vec4(0.5, 0.5, 0.5, 1.0); }
  #endif
}%
