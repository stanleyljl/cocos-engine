CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: landscape-vs:vert
      frag: landscape-fs:frag
      properties:
        mainColor:    { value: [1.0, 1.0, 1.0, 1.0], linear: true, editor: { type: color } }
        # x = height scale (m), y = height bias (m), z = lodColor flag,
        # w = showRanges flag (both debug; CDLOD morph uses lodMorph[] below).
        terrainParams: { value: [3000.0, 0.0, 0.0, 0.0] }
        morphCameraPos: { value: [0.0, 0.0, 0.0, 0.0] }
        terrainWorld: { value: [12288.0, 12288.0, 0.0000813802, 0.0000813802] }
        heightmap: { value: white }
        lodMorph: { value: [0.0, 0.0, 0.0, 0.0] }
}%

CCProgram landscape-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  uniform Constants {
    vec4 mainColor;
    vec4 terrainParams; // x=height scale (m), y=height bias (m), z=lodColor, w=showRanges
    vec4 morphCameraPos;
    // x/y = world dimensions; z/w = reciprocal dimensions.
    vec4 terrainWorld;
    // CDLOD per-level morph thresholds, indexed by node LOD (L0 = finest):
    // .x = morphStart distance, .y = morphEnd (= range[lod]). Uploaded from
    // LandscapeRenderer::setLodRanges; matches Quadtree's CPU selection ranges.
    vec4 lodMorph[8];
  };
  #if __VERSION__ >= 300
    uniform sampler2D heightmap;
  #endif

  #if USE_INSTANCING
    // Per-grid instance data: xy = grid world origin (world-XZ, landscape-local),
    // z = grid world size, w = LOD.
    in vec4 a_gridInst;
  #endif

  out vec3 v_worldPos;
  out vec2 v_terrainXZ;
#if __VERSION__ >= 300
  flat out float v_lod;
#else
  out float v_lod;
#endif

  float sampleHeight (vec2 localXZ) {
    vec2 uv = (localXZ + vec2(0.5 * terrainWorld.x, 0.5 * terrainWorld.y)) * terrainWorld.zw;
  #if __VERSION__ >= 300
    return texture(heightmap, uv).r * terrainParams.x + terrainParams.y;
  #else
    return terrainParams.y;
  #endif
  }

  vec4 vert () {
    vec4 position;
    CCVertInput(position);

    mat4 matWorld;
    CCGetWorldMatrix(matWorld);

    vec2 worldXZ;
    vec2 local = vec2(0.0);
    float gridSize = 0.0;
    float morphK = 0.0;
    bool doMorph = false;
  #if USE_INSTANCING
    local = position.xz;
    gridSize = a_gridInst.z;
    worldXZ = a_gridInst.xy + local * gridSize;
    v_lod = a_gridInst.w;
    doMorph = true;
  #else
    worldXZ = position.xz;
    v_lod = 0.0;
  #endif

    // Standard CDLOD geomorph (no stitch mesh): sample this vertex's height
    // BEFORE morphing and use the full 3D distance to the camera, matching the
    // CPU point-to-AABB metric and the reference CDLOD morph band. The vertical
    // component is intentional: it keeps selection and geomorph thresholds
    // mathematically identical when terrain height varies.
    if (doMorph) {
      float h0 = sampleHeight(worldXZ);
      vec3 worldPos0 = (matWorld * vec4(worldXZ.x, h0, worldXZ.y, 1.0)).xyz;
      float eyeDist = distance(morphCameraPos.xyz, worldPos0);
    #if __VERSION__ >= 300
      int lod = int(v_lod);
      vec2 mm = lodMorph[lod].xy;                      // (morphStart, morphEnd)
      morphK = clamp((eyeDist - mm.x) / max(mm.y - mm.x, 1e-3), 0.0, 1.0);
    #endif

      vec2 gridIdx = local * 16.0;                     // vertex index within grid [0..16]
      vec2 isOdd = fract(gridIdx * 0.5) * 2.0;         // 0 for even node-cells, 1 for odd
      float fineSpacing = gridSize / 16.0;             // finest cell size (m)
      worldXZ -= isOdd * fineSpacing * morphK;         // snap odd cells toward even
    }

    float h = sampleHeight(worldXZ);
    vec4 worldPos = matWorld * vec4(worldXZ.x, h, worldXZ.y, 1.0);
    v_worldPos = worldPos.xyz;
    v_terrainXZ = worldXZ;

    return cc_matProj * (cc_matView * worldPos);
  }
}%

CCProgram landscape-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <legacy/output-standard>

  uniform Constants {
    vec4 mainColor;
    vec4 terrainParams; // x=height scale (m), y=height bias (m), z=lodColor, w=showRanges
    vec4 morphCameraPos;
    vec4 terrainWorld;
    vec4 lodMorph[8];   // must match the vertex Constants block layout
  };
#if __VERSION__ >= 300
  uniform sampler2D heightmap;
#endif

  in vec3 v_worldPos;
  in vec2 v_terrainXZ;
#if __VERSION__ >= 300
  flat in float v_lod;
#else
  in float v_lod;
#endif

  // Exactly the six debug colors used by cdlod_opengl/cdlod.cpp.
  vec3 lodPalette (int lod) {
    if (lod == 0) return vec3(1.00, 0.15, 0.15); // L0 red
    if (lod == 1) return vec3(0.15, 0.90, 0.20); // L1 green
    if (lod == 2) return vec3(0.20, 0.45, 1.00); // L2 blue
    if (lod == 3) return vec3(1.00, 0.90, 0.10); // L3 yellow
    if (lod == 4) return vec3(1.00, 0.15, 0.90); // L4 magenta
    return vec3(0.10, 0.90, 0.95);              // L5 cyan
  }

#if __VERSION__ >= 300
  float sampleHeight (vec2 localXZ) {
    vec2 uv = (localXZ + vec2(0.5 * terrainWorld.x, 0.5 * terrainWorld.y)) * terrainWorld.zw;
    return texture(heightmap, uv).r * terrainParams.x + terrainParams.y;
  }
#endif

  vec4 frag () {
  #if __VERSION__ >= 300
    // Keep the cdlod_opengl fragment calculation unchanged: fixed light,
    // height-based terrain base color, then the optional LOD overlay.
    float spacingX = terrainWorld.x / 2048.0;
    float spacingZ = terrainWorld.y / 2048.0;
    float hLeft = sampleHeight(v_terrainXZ - vec2(spacingX, 0.0));
    float hRight = sampleHeight(v_terrainXZ + vec2(spacingX, 0.0));
    float hBottom = sampleHeight(v_terrainXZ - vec2(0.0, spacingZ));
    float hTop = sampleHeight(v_terrainXZ + vec2(0.0, spacingZ));
    vec3 n = normalize(vec3(hLeft - hRight, 2.0 * spacingX, hBottom - hTop));
    float diff = max(dot(n, normalize(vec3(-0.5, 1.0, -0.35))), 0.0) * 0.85 + 0.15;

    float hN = (v_worldPos.y - terrainParams.y) / terrainParams.x;
    vec3 base = mix(vec3(0.30, 0.45, 0.22), vec3(0.42, 0.38, 0.34), smoothstep(0.35, 0.55, hN));
    base = mix(base, vec3(0.92, 0.94, 0.98), smoothstep(0.70, 0.85, hN));

    // Matches cdlod.cpp: overlay 80% of the six-color palette, then apply
    // the same lighting factor.
    if (terrainParams.z > 0.5) {
      base = mix(base, lodPalette(int(mod(v_lod, 6.0))), 0.80);
    }
    vec3 color = base * diff;

    // Match cdlod.cpp's palette and ring order. The end ring is darkened only
    // for contrast: the demo's raw palette color is too close to the 80%
    // lodColor overlay after terrain lighting is applied.
    if (terrainParams.w > 0.5) {
      float d = distance(morphCameraPos.xyz, v_worldPos);
      float w = fwidth(d) * 1.5;
      for (int i = 0; i < 6; ++i) {
        if (abs(d - lodMorph[i].x) < w) color = mix(lodPalette(i), vec3(0.95), 0.62);
        if (abs(d - lodMorph[i].y) < w) color = lodPalette(i) * 0.45;
      }
    }
  #else
    vec3 color = vec3(0.30, 0.45, 0.22);
  #endif

    return CCFragOutput(vec4(color, 1.0));
  }
}%
