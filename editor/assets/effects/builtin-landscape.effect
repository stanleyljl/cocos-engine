CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: landscape-vs
      frag: landscape-fs
      properties:
        mainColor: { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
        holeParams: { value: [0, 0, 0, 0] }
        holeSplatmap: { sampler: { minFilter: point, magFilter: point, mipFilter: none, addressU: clamp, addressV: clamp, addressW: clamp } }
        terrainParams: { value: [3000, 0, 0, 0] }
        sectorParams: { value: [1, 0, 0, 0] }
        morphCameraPos: { value: [0, 0, 0, 0] }
        heightParams: { value: [1, 129, 0, 0] }
        vtLayout: { value: [4352, 272, 8, 4] }
        decalControl: { value: [1, 0, 0, 0] }
        decalHeightMap: { sampler: { minFilter: linear, magFilter: linear, mipFilter: none, addressU: clamp, addressV: clamp, addressW: clamp } }
        rvtNormalParams: { value: [1, 0, 0, 0] }
        vtAlbedo: { value: white, sampler: { minFilter: linear, magFilter: linear, mipFilter: linear, addressU: clamp, addressV: clamp, addressW: clamp } }
        vtNormalRoughnessAO: { value: white, sampler: { minFilter: linear, magFilter: linear, mipFilter: linear, addressU: clamp, addressV: clamp, addressW: clamp } }
        # Runtime texture arrays are bound by LandscapeRenderer before the
        # material is used by a model. Leaving value unset makes Pass use its
        # existing non-null default during validated material initialization.
        heightmap: { sampler: { minFilter: linear, magFilter: linear, addressU: clamp, addressV: clamp, addressW: clamp } }
        terrainNormalMap: { sampler: { minFilter: linear, magFilter: linear, mipFilter: none, addressU: clamp, addressV: clamp, addressW: clamp } }
        lodMorph: { value: [0, 0, 0, 0] }
    - vert: landscape-vs
      frag: landscape-fs
      phase: forward-add
      propertyIndex: 0
      embeddedMacros: { CC_FORWARD_ADD: true }
      depthStencilState:
        depthFunc: equal
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: one
          blendDst: one
          blendSrcAlpha: zero
          blendDstAlpha: one
    - vert: landscape-shadow-vs
      frag: landscape-shadow-fs
      phase: shadow-caster
      propertyIndex: 0
      rasterizerState:
        # Heightfields are open surfaces: front-face culling loses sun-facing terrain.
        cullMode: none
    - vert: landscape-vs
      frag: landscape-fs
      phase: deferred-forward
      propertyIndex: 0
      embeddedMacros: { CC_FORCE_FORWARD_SHADING: true }
  - name: hole-probe
    passes:
    - vert: landscape-hole-probe-vs:vert
      frag: landscape-hole-probe-fs:frag
      rasterizerState: { cullMode: none }
      depthStencilState: { depthTest: false, depthWrite: false }
      properties:
        probeParams: { value: [0, 0, 0, 0] }
}%

CCProgram landscape-uniforms %{
  // L0-L8; maximum sector size = 4096 m at 1 m finest-grid spacing.
  // Must match config::MAX_LOD_LEVELS in LandscapeConfig.h.
  #define LANDSCAPE_MAX_LOD_LEVELS 9
  uniform Constants {
    vec4 mainColor;
    vec4 terrainParams; // height scale/bias, LOD color flag, range flag
    vec4 sectorParams; // sector size, unused YZW
    vec4 morphCameraPos;
    vec4 heightParams; // height sample spacing (m), tile resolution, unused ZW
    vec4 vtLayout; // atlas size, slot size, border, coarsest-mip filter margin in base texels
    vec4 decalControl; // Enable nearby decal geometry; cached material is unchanged
    vec4 rvtNormalParams; // 1 = baked terrain-local normals, 0 = tangent-space detail
    // Effect reflection requires a literal array length; keep it equal to LANDSCAPE_MAX_LOD_LEVELS.
    vec4 lodMorph[9];
    vec4 holeParams; // 0 = verified vertex NaN, 1 = fragment discard
  };
}%

CCProgram landscape-macros %{
  #ifndef LANDSCAPE_SHADOW_PASS
    #define LANDSCAPE_SHADOW_PASS 0
  #endif
  // VT albedo diagnostic. Disabled by default; switched by LandscapeRenderer.
  #pragma define-meta LANDSCAPE_DEBUG_UNLIT
  #pragma define-meta LANDSCAPE_DECAL_MESH
  #pragma define-meta LANDSCAPE_WIREFRAME
  #pragma define-meta LANDSCAPE_HEIGHT_UNORM
  #define CC_SURFACES_USE_TANGENT_SPACE 1
  #include <surfaces/effect-macros/terrain>
}%

CCProgram landscape-hole-sampling %{
  #if __VERSION__ >= 300
    uniform highp usampler2DArray holeSplatmap;
    bool landscapeHole(vec2 localXZ, vec4 region, bool vertexSample) {
      vec2 grid = clamp((localXZ - region.xy) / region.z, vec2(0.0), vec2(1.0)) * (heightParams.y - 1.0);
      // Vertices use aligned point samples. Fragments/physics use the cell's minimum corner.
      ivec2 p = vertexSample ? ivec2(floor(grid + 0.5)) : min(ivec2(floor(grid)), ivec2(int(heightParams.y) - 2));
      return (texelFetch(holeSplatmap, ivec3(p, int(region.w + 0.5)), 0).r & 32768u) != 0u;
    }
  #endif
}%

CCProgram landscape-hole-fragment %{
  #include <landscape-hole-sampling>
  #if __VERSION__ >= 300
    in highp vec2 v_holeXZ;
    flat in highp vec4 v_holeRegion;
  #endif
  void discardLandscapeHole() {
    #if __VERSION__ >= 300
      if (holeParams.x > 0.5 && landscapeHole(v_holeXZ, v_holeRegion, false)) discard;
    #endif
  }
}%

CCProgram landscape-vertex %{
  #include <landscape-hole-sampling>
  #if __VERSION__ >= 300
    out highp vec2 v_holeXZ;
    flat out highp vec4 v_holeRegion;
  #endif
  #if LANDSCAPE_WIREFRAME && !LANDSCAPE_SHADOW_PASS
    out vec3 v_wireBarycentric;
  #endif
  #if USE_INSTANCING
    in vec4 a_gridInst; // parent local XZ origin, node size, LOD
    in vec4 a_quadrantInst; // UV offset XY, patch UV size Z, coarse-neighbor edge mask W
    in vec4 a_tileInst; // source tile local XZ origin, size, paired array layer
    #if !LANDSCAPE_SHADOW_PASS
      in vec4 a_vtInst; // resident VT region XZ origin, size, physical slot
    #endif
    #if LANDSCAPE_DECAL_MESH
      in vec4 a_decalRegion; // minimum XZ, world size, height texture layer
      in vec4 a_decalGrid; // fixed XZ origin, width and depth; independent of LOD
      in vec4 a_decalFade; // height scale, whole-decal distance fade, unused ZW
    #endif
  #endif
  #if __VERSION__ >= 300
    uniform highp sampler2DArray heightmap;
    #if LANDSCAPE_DECAL_MESH
      uniform highp sampler2DArray decalHeightMap;
      out float v_decalLift;
    #endif
    #if !LANDSCAPE_SHADOW_PASS
      flat out float v_lod;
      flat out vec4 v_vtParams;
      out vec2 v_normalUV;
      flat out float v_normalLayer;
    #endif
  #else
    #if !LANDSCAPE_SHADOW_PASS
      out float v_lod;
    #endif
  #endif

  #if __VERSION__ >= 300 && USE_INSTANCING && !LANDSCAPE_HEIGHT_UNORM
  highp float fetchHeightSample(ivec2 texel, int layer) {
    highp vec2 bytes = floor(texelFetch(heightmap, ivec3(texel, layer), 0).rg * 255.0 + 0.5);
    return dot(bytes, vec2(256.0, 1.0));
  }
  #endif

  highp float sampleHeightRegion(highp vec2 localXZ, highp vec4 region) {
  #if __VERSION__ >= 300 && USE_INSTANCING
    #if LANDSCAPE_HEIGHT_UNORM
    highp vec2 tileUv = clamp((localXZ - region.xy) / max(region.z, 1e-6), vec2(0.0), vec2(1.0));
    highp float resolution = max(heightParams.y, 2.0);
    tileUv = (tileUv * (resolution - 1.0) + 0.5) / resolution;
    return textureLod(heightmap, vec3(tileUv, region.w), 0.0).r * terrainParams.x + terrainParams.y;
    #else
    // RG stores the high/low bytes of one uint16 height, not two colors.
    // Decode before filtering: limited-precision UNORM filtering can amplify
    // rounding across a byte carry (e.g. 0x7fff -> 0x8000) into height spikes
    // as CDLOD morph moves vertices between samples on mobile GPUs.
    highp vec2 tileUv = clamp((localXZ - region.xy) / max(region.z, 1e-6), vec2(0.0), vec2(1.0));
    int lastTexel = max(int(heightParams.y), 2) - 1;
    highp vec2 grid = tileUv * float(lastTexel);
    ivec2 p0 = ivec2(floor(grid));
    ivec2 p1 = min(p0 + ivec2(1), ivec2(lastTexel));
    highp vec2 weight = fract(grid);
    int layer = int(region.w + 0.5);
    highp float h00 = fetchHeightSample(p0, layer);
    highp float h10 = fetchHeightSample(ivec2(p1.x, p0.y), layer);
    highp float h01 = fetchHeightSample(ivec2(p0.x, p1.y), layer);
    highp float h11 = fetchHeightSample(p1, layer);
    highp float height = mix(mix(h00, h10, weight.x), mix(h01, h11, weight.x), weight.y);
    return height / 65535.0 * terrainParams.x + terrainParams.y;
    #endif
  #else
    return terrainParams.y;
  #endif
  }

  float sampleHeight(vec2 localXZ) {
  #if USE_INSTANCING
    return sampleHeightRegion(localXZ, a_tileInst);
  #else
    return terrainParams.y;
  #endif
  }

  #if __VERSION__ >= 300 && USE_INSTANCING
  vec4 terrainVertex(vec2 parentUV) {
    vec2 grid = floor(parentUV * 16.0 + 0.5);
    int edges = int(a_quadrantInst.w + 0.5);
    // Only the fine side of an actual 2:1 boundary collapses odd vertices.
    // The coarse side remains fixed. This applies identically to color,
    // shadow, wireframe and decal reconstruction, regardless of IO latency.
    bool coarseX = (grid.x < 0.5 && (edges & 1) != 0) || (grid.x > 15.5 && (edges & 2) != 0);
    bool coarseZ = (grid.y < 0.5 && (edges & 4) != 0) || (grid.y > 15.5 && (edges & 8) != 0);
    if (coarseX) grid.y -= mod(grid.y, 2.0);
    if (coarseZ) grid.x -= mod(grid.x, 2.0);
    vec2 xz = a_gridInst.xy + grid * (a_gridInst.z / 16.0);
    return vec4(xz.x, sampleHeight(xz), xz.y, 0.0);
  }
  #if LANDSCAPE_DECAL_MESH
  bool decalTriangleHeight(vec2 xz, vec4 a, vec4 b, vec4 c, out vec2 heightMorph) {
    vec2 ab = b.xz - a.xz;
    vec2 ac = c.xz - a.xz;
    vec2 ap = xz - a.xz;
    float det = ab.x * ac.y - ab.y * ac.x;
    // Odd CDLOD vertices eventually collapse onto the even lattice. Ignore
    // collapsed triangles rather than dividing by a nearly zero area.
    float cellSize = a_gridInst.z / 16.0;
    if (abs(det) < cellSize * cellSize * 1e-8) return false;
    vec2 w = vec2(ap.x * ac.y - ap.y * ac.x, ab.x * ap.y - ab.y * ap.x) / det;
    if (min(min(w.x, w.y), 1.0 - w.x - w.y) < -1e-5) return false;
    heightMorph = a.yw * (1.0 - w.x - w.y) + b.yw * w.x + c.yw * w.y;
    return true;
  }

  vec4 decalTerrainAt(vec2 xz) {
    // Even vertices never move in XZ; a morphed 2x2 cell block keeps its
    // footprint. Invert its triangles to find Y at the FIXED decal position.
    // Interpolating forward from the original cell barycentrics would drag
    // the decal across its height texture and change the stone's silhouette.
    vec2 grid = (xz - a_gridInst.xy) / a_gridInst.z * 16.0;
    vec2 block = clamp(floor(grid * 0.5) * 2.0, vec2(0.0), vec2(14.0));
    vec4 p[9];
    for (int z = 0; z < 3; ++z) {
      for (int x = 0; x < 3; ++x) {
        p[z * 3 + x] = terrainVertex((block + vec2(float(x), float(z))) / 16.0);
      }
    }
    vec2 heightMorph;
    for (int z = 0; z < 2; ++z) {
      for (int x = 0; x < 2; ++x) {
        int i = z * 3 + x;
        if (decalTriangleHeight(xz, p[i], p[i + 1], p[i + 3], heightMorph))
          return vec4(xz.x, heightMorph.x, xz.y, heightMorph.y);
        if (decalTriangleHeight(xz, p[i + 4], p[i + 3], p[i + 1], heightMorph))
          return vec4(xz.x, heightMorph.x, xz.y, heightMorph.y);
      }
    }
    // Only reached for coordinates outside the node or roundoff at its edge.
    return vec4(xz.x, sampleHeight(xz), xz.y, 0.0);
  }
  #endif
  #endif

  #define CC_SURFACES_VERTEX_MODIFY_LOCAL_POS
  vec3 SurfacesVertexModifyLocalPos(in SurfacesStandardVertexIntermediate In) {
    // The RG32F buffer packs terrain XZ into the first two input components.
    // Keep the shared surface input unchanged; reconstruct XYZ on return.
    vec2 localXZ = In.position.xy;
  #if LANDSCAPE_WIREFRAME && !LANDSCAPE_SHADOW_PASS
    float wireCells = 16.0; // Fixed decal grid.
    #if USE_INSTANCING && !LANDSCAPE_DECAL_MESH
      wireCells = a_quadrantInst.z * 16.0;
    #endif
    // GridMesh uses (a,c,b), (b,c,d). This three-colouring gives each
    // triangle all three barycentric corners without duplicating vertices.
    // Derive from the original lattice so edges follow geometry morphing.
    vec2 wireGrid = floor(In.position.xy * wireCells + 0.5);
    float wireCorner = mod(wireGrid.x + 2.0 * wireGrid.y, 3.0);
    v_wireBarycentric = wireCorner < 0.5 ? vec3(1.0, 0.0, 0.0)
      : (wireCorner < 1.5 ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0));
  #endif
  #if !LANDSCAPE_SHADOW_PASS
    v_lod = 0.0;
  #if __VERSION__ >= 300
    v_vtParams = vec4(0.0, 0.0, 1.0, 0.0);
    v_normalUV = vec2(0.5);
    v_normalLayer = 0.0;
    #if USE_INSTANCING
      v_vtParams = a_vtInst;
    #endif
  #endif
  #endif
  #if USE_INSTANCING
    vec2 parentUV = a_quadrantInst.xy + In.position.xy * a_quadrantInst.z;
    localXZ = a_gridInst.xy + parentUV * a_gridInst.z;
    #if !LANDSCAPE_SHADOW_PASS
      v_lod = a_gridInst.w;
    #endif
  #endif
    float height = sampleHeight(localXZ);
  #if __VERSION__ >= 300 && USE_INSTANCING
    vec4 base;
    #if LANDSCAPE_DECAL_MESH
      base = decalTerrainAt(a_decalGrid.xy + In.position.xy * a_decalGrid.zw);
      vec2 uv = (base.xz - a_decalRegion.xy) / a_decalRegion.z;
      vec2 encoded = textureLod(decalHeightMap, vec3(clamp(uv, vec2(0.0), vec2(1.0)), a_decalRegion.w), 0.0).rg;
      v_decalLift = dot(encoded, vec2(256.0, 1.0)) / 257.0 * a_decalFade.x * a_decalFade.y * decalControl.x;
      if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) v_decalLift = 0.0;
      base.y += v_decalLift;
    #else
      base = terrainVertex(parentUV);
    #endif
    localXZ = base.xz;
    height = base.y;
  #endif
  #if __VERSION__ >= 300 && USE_INSTANCING && !LANDSCAPE_SHADOW_PASS
    // Identical final world coordinates for geometry and both normal levels.
    float resolution = max(heightParams.y, 2.0);
    v_normalUV = (localXZ - a_tileInst.xy) / a_tileInst.z;
    v_normalUV = v_normalUV * ((resolution - 1.0) / resolution) + 0.5 / resolution;
    v_normalLayer = a_tileInst.w;
  #endif
    #if __VERSION__ >= 300
      v_holeXZ = localXZ;
      v_holeRegion = vec4(0.0, 0.0, 1.0, 0.0);
      #if USE_INSTANCING
        v_holeRegion = a_tileInst;
        if (holeParams.x < 0.5 && landscapeHole(localXZ, a_tileInst, true)) height = uintBitsToFloat(0x7fc00000u);
      #endif
    #endif
    // Sample base terrain at the final morphed coordinate.
    return vec3(localXZ.x, height, localXZ.y);
  }

  #define CC_SURFACES_VERTEX_MODIFY_LOCAL_SHARED_DATA
  void SurfacesVertexModifyLocalSharedData(inout SurfacesStandardVertexIntermediate In) {
    // Supply only the terrain coordinate frame; slopes come from RG8 normal
    // maps per pixel, not from sparsely sampled, interpolated vertex normals.
    In.normal = vec3(0.0, 1.0, 0.0);
    In.tangent = vec4(1.0, 0.0, 0.0, 1.0);
  }

  #define CC_SURFACES_VERTEX_MODIFY_UV
  void SurfacesVertexModifyUV(inout SurfacesStandardVertexIntermediate In) {
    In.texCoord = vec2(In.position.x, -In.position.z);
  }
}%

CCProgram landscape-surface %{
  #include <landscape-hole-fragment>
  #if LANDSCAPE_WIREFRAME
    in vec3 v_wireBarycentric;
  #endif
  #if __VERSION__ >= 300 && LANDSCAPE_DECAL_MESH
    in float v_decalLift;
  #endif
  #if __VERSION__ >= 300
    uniform sampler2D vtAlbedo;
    uniform sampler2D vtNormalRoughnessAO;
    flat in vec4 v_vtParams;
    #if !LANDSCAPE_DEBUG_UNLIT
      uniform highp sampler2DArray terrainNormalMap;
      in vec2 v_normalUV;
      flat in float v_normalLayer;
    #endif
  #endif
  #if __VERSION__ >= 300
    flat in float v_lod;
  #else
    in float v_lod;
  #endif

  vec3 lodPalette(int lod) {
    if (lod == 0) return vec3(1.00, 0.15, 0.15);
    if (lod == 1) return vec3(0.15, 0.90, 0.20);
    if (lod == 2) return vec3(0.20, 0.45, 1.00);
    if (lod == 3) return vec3(1.00, 0.90, 0.10);
    if (lod == 4) return vec3(1.00, 0.15, 0.90);
    if (lod == 5) return vec3(0.10, 0.90, 0.95);
    if (lod == 6) return vec3(0.65, 0.35, 0.85);
    if (lod == 7) return vec3(0.95, 0.55, 0.20);
    return vec3(0.90, 0.90, 0.90);
  }

  #if LANDSCAPE_DEBUG_UNLIT
    #include <surfaces/data-structures/unlit>
  #else
    #include <surfaces/data-structures/standard>
  #endif
  #define CC_SURFACES_FRAGMENT_MODIFY_SHARED_DATA
  void SurfacesFragmentModifySharedData(inout SurfacesMaterialData surfaceData) {
    #if LANDSCAPE_WIREFRAME
      // Evaluate derivatives before any discard. Width is in screen pixels.
      vec3 wireDistance = v_wireBarycentric / max(fwidth(v_wireBarycentric), vec3(1e-6));
    #endif
    #if __VERSION__ >= 300
      // Derivatives must be evaluated before decal discard.
      vec2 localXZ = vec2(FSInput_texcoord.x, -FSInput_texcoord.y);
      vec2 localDX = dFdx(localXZ), localDY = dFdy(localXZ);
    #endif
    #if __VERSION__ >= 300 && LANDSCAPE_DECAL_MESH
      // Flat collar pixels already exist on the terrain: avoid coplanar overlap.
      if (v_decalLift <= 0.001) discard;
    #endif
    discardLandscapeHole();
    vec3 albedo = vec3(0.0);
  #if !LANDSCAPE_DEBUG_UNLIT
    vec3 detailNormal = vec3(0.0, 0.0, 1.0);
    vec3 terrainNormal = vec3(0.0, 1.0, 0.0);
    float roughness = 1.0;
    float ao = 1.0;
  #endif
  #if __VERSION__ >= 300
    // Each patch carries one resident mapping covering its entire stitched geometry footprint.
    vec2 nodeUV = clamp((localXZ - v_vtParams.xy) / v_vtParams.z, vec2(0.0), vec2(1.0));
    float count = vtLayout.x / vtLayout.y;
    vec2 slot = vec2(mod(v_vtParams.w, count), floor(v_vtParams.w / count));
    vec2 atlasUV = (slot * vtLayout.y + vtLayout.z + nodeUV * (vtLayout.y - 2.0*vtLayout.z)) / vtLayout.x;
    float gradientScale = (vtLayout.y - 2.0 * vtLayout.z) / (vtLayout.x * v_vtParams.z);
    vec2 atlasDX = localDX * gradientScale, atlasDY = localDY * gradientScale;
    // CLAMP protects only the entire atlas, not a physical slot. Bound the
    // pixel footprint at page edges, at every actual material precision.
    // Leave one coarsest-mip texel for bilinear support; scale both gradients
    // together to preserve their anisotropy and direction.
    vec2 room = vtLayout.z + min(nodeUV, vec2(1.0) - nodeUV) * (vtLayout.y - 2.0 * vtLayout.z) - vtLayout.w;
    vec2 span = (abs(atlasDX) + abs(atlasDY)) * vtLayout.x;
    vec2 scaleLimit = 2.0 * max(room, vec2(0.0)) / max(span, vec2(1e-6));
    float footprintScale = min(1.0, min(scaleLimit.x, scaleLimit.y));
    atlasDX *= footprintScale;
    atlasDY *= footprintScale;
    vec4 cachedAlbedo = textureGrad(vtAlbedo, atlasUV, atlasDX, atlasDY);
    albedo = cachedAlbedo.rgb;
    #if !LANDSCAPE_DEBUG_UNLIT
    vec4 nra = textureGrad(vtNormalRoughnessAO, atlasUV, atlasDX, atlasDY);
    detailNormal = normalize(vec3(nra.r, cachedAlbedo.a, nra.g) * 2.0 - 1.0);
    if (rvtNormalParams.x < 0.5) {
      // The exact source of the committed height node supplies its base normal.
      vec2 terrainXZ = texture(terrainNormalMap, vec3(v_normalUV, v_normalLayer)).rg * 2.0 - 1.0;
      terrainNormal = normalize(vec3(terrainXZ.x, sqrt(max(1.0 - dot(terrainXZ, terrainXZ), 0.0)), terrainXZ.y));
    }
    roughness = nra.b;
    ao = nra.a;
    #endif
  #endif
    surfaceData.baseColor = vec4(albedo * mainColor.rgb, 1.0);
  #if !LANDSCAPE_DEBUG_UNLIT
    // RVT normals use NRA.RG for XZ and albedo.A for Y; opacity stays 1.
    vec3 normal = normalize(FSInput_worldNormal);
    vec3 tangent = normalize(FSInput_worldTangent - normal * dot(normal, FSInput_worldTangent));
    vec3 localNormal = detailNormal;
    if (rvtNormalParams.x < 0.5) {
      vec3 t = vec3(terrainNormal.y, -terrainNormal.x, 0.0);
      vec3 terrainTangent = dot(t, t) > 1e-10 ? normalize(t) : vec3(1.0, 0.0, 0.0);
      vec3 terrainBitangent = cross(terrainNormal, terrainTangent);
      localNormal = normalize(terrainTangent * detailNormal.x + terrainBitangent * detailNormal.y + terrainNormal * detailNormal.z);
    }
    // The surface frame is (+X, -Z, +Y); transform the composed local normal
    // through it so node transforms retain the existing world-space behavior.
    surfaceData.worldNormal = normalize(CalculateNormalFromTangentSpace(vec3(localNormal.x, -localNormal.z, localNormal.y), 1.0,
      normal, tangent, FSInput_mirrorNormal));
    surfaceData.roughness = roughness;
    surfaceData.ao = ao;
    surfaceData.metallic = 0.0;
    surfaceData.specularIntensity = 0.5;
    surfaceData.emissive = vec3(0.0);
  #endif

    if (terrainParams.z > 0.5) {
      surfaceData.baseColor.rgb = lodPalette(int(v_lod));
    }
    if (terrainParams.w > 0.5) {
      float d = distance(morphCameraPos.xyz, FSInput_worldPos);
      float width = fwidth(d) * 1.5;
      for (int i = 0; i < LANDSCAPE_MAX_LOD_LEVELS; ++i) {
        if (lodMorph[i].y <= lodMorph[i].x) continue; // Unused resource levels.
        if (abs(d - lodMorph[i].x) < width) surfaceData.baseColor.rgb = mix(lodPalette(i), vec3(0.95), 0.62);
        if (abs(d - lodMorph[i].y) < width) surfaceData.baseColor.rgb = lodPalette(i) * 0.45;
      }
      // Use local terrain coordinates so seams follow the rendered surface,
      // including geomorph and node transforms. Differentiate before wrapping.
      vec2 sectorUV = vec2(FSInput_texcoord.x, -FSInput_texcoord.y) / max(sectorParams.x, 1e-6);
      vec2 seamDistance = abs(fract(sectorUV + 0.5) - 0.5);
      vec2 seamWidth = max(fwidth(sectorUV) * 1.5, vec2(1e-6));
      if (any(lessThan(seamDistance, seamWidth))) {
        surfaceData.baseColor.rgb = vec3(1.0, 0.3, 0.0);
      }
    }
    #if LANDSCAPE_WIREFRAME
      // Keep texture/derivative evaluation above in uniform control flow.
      // Shared edges receive an inward strip from each adjacent triangle.
      if (min(min(wireDistance.x, wireDistance.y), wireDistance.z) > 0.4) discard;
    #endif
  }
}%

CCProgram landscape-vs %{
  precision highp float;
  precision highp int;
  #include <landscape-macros>
  #include <surfaces/includes/common-vs>
  #include <landscape-uniforms>
  #include <landscape-vertex>
  #include <surfaces/includes/standard-vs>
  #include <shading-entries/main-functions/render-to-scene/vs>
}%

CCProgram landscape-fs %{
  precision highp float;
  precision highp int;
  #include <landscape-macros>
  #include <surfaces/includes/common-fs>
  #include <landscape-uniforms>
  #include <landscape-surface>
  // Effect chunks are included only once, even across conditional branches.
  // Hoist shared dependencies so both PBR and unlit variants receive them.
  #include <lighting-models/includes/common>
  #include <common/lighting/brdf>
  #include <surfaces/module-functions/debug-view>
  #if LANDSCAPE_DEBUG_UNLIT
    #include <lighting-models/includes/unlit>
    #include <surfaces/includes/unlit-fs>
  #else
    #include <lighting-models/includes/standard>
    #include <surfaces/includes/standard-fs>
  #endif
  #include <shading-entries/main-functions/render-to-scene/fs>
}%

CCProgram landscape-shadow-vs %{
  precision highp float;
  precision highp int;
  #define LANDSCAPE_SHADOW_PASS 1
  #include <landscape-macros>
  #include <surfaces/effect-macros/render-to-shadowmap>
  #include <surfaces/includes/common-vs>
  #include <landscape-uniforms>
  #include <landscape-vertex>
  #include <shading-entries/main-functions/render-to-shadowmap/vs>
}%

CCProgram landscape-shadow-fs %{
  precision highp float;
  precision highp int;
  #include <landscape-macros>
  #include <surfaces/effect-macros/render-to-shadowmap>
  #include <surfaces/includes/common-fs>
  #include <landscape-uniforms>

  #include <landscape-hole-fragment>
  in highp vec2 v_clip_depth;
  #if __VERSION__ >= 300 && LANDSCAPE_DECAL_MESH
    in float v_decalLift;
  #endif
  layout(location = 0) out vec4 fragColorX;

  void main () {
    highp float depth = v_clip_depth.x / v_clip_depth.y * 0.5 + 0.5;
    #if CC_SHADOWMAP_USE_LINEAR_DEPTH
      if (IS_SPOT_LIGHT(cc_shadowLPNNInfo.x)) {
        depth = CCGetLinearDepth(FSInput_worldPos.xyz);
      }
    #endif

    // An open heightfield must cast its sun-facing surface. Unlike a closed
    // mesh, front-face culling cannot suppress its self-shadowing. Bias the
    // stored COLOR depth across the PCF footprint (rasterizer depth bias only
    // affects the depth attachment, which Cocos does not sample for shadows).
    // Include half a texel for receiver/caster sample-center disagreement.
    float radius = cc_shadowWHPBInfo.z > 2.5 ? 2.5 : (cc_shadowWHPBInfo.z > 0.5 ? 1.5 : 0.5);
    float slope = abs(dFdx(depth)) + abs(dFdy(depth));
    depth = min(depth + radius * slope, 1.0 - 1.0 / 16777216.0);

    #if __VERSION__ >= 300 && LANDSCAPE_DECAL_MESH
      // Match the main pass: a flat decal collar is not an extra occluder.
      if (v_decalLift <= 0.001) discard;
    #endif
    discardLandscapeHole();
    #if CC_SHADOWMAP_FORMAT == SHADOWMAP_FORMAT_RGBA8
      fragColorX = packDepthToRGBA(depth);
    #else
      fragColorX = vec4(depth, 1.0, 1.0, 1.0);
    #endif
  }
}%

CCProgram landscape-hole-probe-vs %{
  precision highp float;
  precision highp int;
  in vec2 a_position;
  uniform Probe { vec4 probeParams; };
  vec4 vert() {
    vec4 p = vec4(a_position * 2.0 - 1.0, 0.5, 1.0);
    #if __VERSION__ >= 300
      if (probeParams.x > 0.5 && a_position.x > 0.5 && a_position.y < 0.5) p = vec4(uintBitsToFloat(0x7fc00000u));
    #endif
    return p;
  }
}%
CCProgram landscape-hole-probe-fs %{
  precision highp float;
  vec4 frag() { return vec4(1.0); }
}%
