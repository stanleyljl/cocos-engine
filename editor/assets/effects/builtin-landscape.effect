CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: landscape-vs
      frag: landscape-fs
      properties:
        mainColor: { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
        terrainParams: { value: [3000, 0, 0, 0] }
        morphCameraPos: { value: [0, 0, 0, 0] }
        heightParams: { value: [1, 129, 0, 0] }
        detailParams: { value: [0.1, 1, 0, 0] }
        materialParams: { value: [0, 0, 0, 0] }
        # Runtime texture arrays are bound by LandscapeRenderer before the
        # material is used by a model. Leaving value unset makes Pass use its
        # existing non-null default during validated material initialization.
        splatmap: { sampler: { minFilter: point, magFilter: point, addressU: clamp, addressV: clamp, addressW: clamp } }
        heightmap: { sampler: { minFilter: linear, magFilter: linear, addressU: clamp, addressV: clamp, addressW: clamp } }
        albedoHeightMap: { sampler: { minFilter: linear, magFilter: linear, mipFilter: linear, addressU: wrap, addressV: wrap } }
        normalRoughnessAOMap: { sampler: { minFilter: linear, magFilter: linear, mipFilter: linear, addressU: wrap, addressV: wrap } }
        lodMorph: { value: [0, 0, 0, 0] }
    - vert: landscape-vs
      frag: landscape-fs
      phase: forward-add
      propertyIndex: 0
      embeddedMacros: { CC_FORWARD_ADD: true }
      depthStencilState:
        depthFunc: equal
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: one
          blendDst: one
          blendSrcAlpha: zero
          blendDstAlpha: one
    - vert: landscape-shadow-vs
      frag: landscape-shadow-fs
      phase: shadow-caster
      propertyIndex: 0
      rasterizerState:
        cullMode: front
    - vert: landscape-vs
      frag: landscape-fs
      phase: deferred-forward
      propertyIndex: 0
      embeddedMacros: { CC_FORCE_FORWARD_SHADING: true }
}%

CCProgram landscape-uniforms %{
  uniform Constants {
    vec4 mainColor;
    vec4 terrainParams; // height scale/bias, LOD color flag, range flag
    vec4 morphCameraPos;
    vec4 heightParams; // height sample spacing (m), tile resolution
    vec4 detailParams[32]; // per-layer UV repeats/m, detailHeightScale, detailHeightBias
    vec4 materialParams; // any layer uses detail displacement
    vec4 lodMorph[8];
  };
}%

CCProgram landscape-macros %{
  #define CC_SURFACES_USE_TANGENT_SPACE 1
  #include <surfaces/effect-macros/terrain>
}%

CCProgram landscape-splat %{
  #if __VERSION__ >= 300
    uniform highp usampler2DArray splatmap;
    uniform sampler2DArray albedoHeightMap;

    void landscapeSplatSamples(vec2 localXZ, vec4 tile, out uvec4 packed, out vec4 weights) {
      float edge = heightParams.y - 1.0;
      vec2 pixel = clamp((localXZ - tile.xy) / tile.z * edge, vec2(0.0), vec2(edge));
      ivec2 origin = ivec2(min(floor(pixel), vec2(edge - 1.0)));
      vec2 f = pixel - vec2(origin);
      int page = int(tile.w);
      packed = uvec4(texelFetch(splatmap, ivec3(origin, page), 0).r,
                     texelFetch(splatmap, ivec3(origin + ivec2(1, 0), page), 0).r,
                     texelFetch(splatmap, ivec3(origin + ivec2(0, 1), page), 0).r,
                     texelFetch(splatmap, ivec3(origin + ivec2(1, 1), page), 0).r);
      weights = vec4((1.0 - f.x) * (1.0 - f.y), f.x * (1.0 - f.y),
                     (1.0 - f.x) * f.y, f.x * f.y);
    }
  #endif
}%

CCProgram landscape-vertex %{
  #if USE_INSTANCING
    in vec4 a_gridInst;   // local XZ origin, node size, LOD
    in vec4 a_tileInst; // source tile local XZ origin, size in meters, paired array layer
  #endif
  #if __VERSION__ >= 300
    uniform sampler2DArray heightmap;
    flat out float v_lod;
    flat out vec4 v_tileParams;
  #else
    out float v_lod;
  #endif

  float sampleHeight(vec2 localXZ) {
  #if __VERSION__ >= 300 && USE_INSTANCING
    vec2 tileUv = (localXZ - a_tileInst.xy) / max(a_tileInst.z, 1e-6);
    float resolution = max(heightParams.y, 2.0);
    tileUv = tileUv * ((resolution - 1.0) / resolution) + 0.5 / resolution;
    vec2 encoded = textureLod(heightmap, vec3(clamp(tileUv, vec2(0.0), vec2(1.0)), a_tileInst.w), 0.0).rg;
    return dot(encoded, vec2(256.0, 1.0)) / 257.0 * terrainParams.x + terrainParams.y;
  #else
    return terrainParams.y;
  #endif
  }

  #if __VERSION__ >= 300
    float sampleLayerHeight(int layer, vec2 localXZ) {
      vec4 params = detailParams[layer];
      if (params.y == 0.0) return params.z;
      vec2 uv = vec2(localXZ.x, -localXZ.y) * params.x;
      return textureLod(albedoHeightMap, vec3(uv, float(layer)), 0.0).a * params.y + params.z;
    }

    float sampleDetailHeight(vec2 localXZ, vec4 tile) {
      uvec4 packed;
      vec4 weights;
      landscapeSplatSamples(localXZ, tile, packed, weights);
      float height = 0.0;
      for (int i = 0; i < 4; ++i) {
        uint value = packed[i];
        int layer0 = int(value & 31u);
        int layer1 = int((value >> 5u) & 31u);
        float weight = float(value >> 10u) / 63.0;
        height += weights[i] * mix(sampleLayerHeight(layer0, localXZ), sampleLayerHeight(layer1, localXZ), weight);
      }
      return height;
    }
  #endif

  #define CC_SURFACES_VERTEX_MODIFY_LOCAL_POS
  vec3 SurfacesVertexModifyLocalPos(in SurfacesStandardVertexIntermediate In) {
    vec2 localXZ = In.position.xz;
    v_lod = 0.0;
  #if __VERSION__ >= 300
    v_tileParams = vec4(0.0, 0.0, 1.0, 0.0);
    #if USE_INSTANCING
      v_tileParams = a_tileInst;
    #endif
  #endif
  #if USE_INSTANCING
    localXZ = a_gridInst.xy + In.position.xz * a_gridInst.z;
    v_lod = a_gridInst.w;
    // LOD depends only on base terrain. Detail height is deliberately excluded.
    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    vec3 baseWorld = (matWorld * vec4(localXZ.x, sampleHeight(localXZ), localXZ.y, 1.0)).xyz;
    float eyeDist = distance(morphCameraPos.xyz, baseWorld);
    #if __VERSION__ >= 300
      vec2 range = lodMorph[int(v_lod)].xy;
      float morph = clamp((eyeDist - range.x) / max(range.y - range.x, 1e-3), 0.0, 1.0);
      vec2 odd = fract(In.position.xz * 16.0 * 0.5) * 2.0;
      localXZ -= odd * (a_gridInst.z / 16.0) * morph;
    #endif
  #endif
    float height = sampleHeight(localXZ);
    // Sample at the final morphed coordinate so coincident edge vertices agree.
    // Fixed mip level keeps geometry unchanged when the frozen camera moves.
  #if __VERSION__ >= 300 && USE_INSTANCING
    if (materialParams.x > 0.5) {
      height += sampleDetailHeight(localXZ, a_tileInst);
    }
  #endif
    return vec3(localXZ.x, height, localXZ.y);
  }

  #define CC_SURFACES_VERTEX_MODIFY_LOCAL_SHARED_DATA
  void SurfacesVertexModifyLocalSharedData(inout SurfacesStandardVertexIntermediate In) {
    vec2 p = In.position.xz;
    float stepSize = max(heightParams.x, 0.001);
    float dx = (sampleHeight(p + vec2(stepSize, 0.0)) - sampleHeight(p - vec2(stepSize, 0.0))) / (2.0 * stepSize);
    float dz = (sampleHeight(p + vec2(0.0, stepSize)) - sampleHeight(p - vec2(0.0, stepSize))) / (2.0 * stepSize);
    In.normal = normalize(vec3(-dx, 1.0, -dz));
    // OpenGL tangent normal: U along +X, V along -Z, B = cross(N, T).
    In.tangent = vec4(normalize(vec3(1.0, dx, 0.0)), 1.0);
  }

  #define CC_SURFACES_VERTEX_MODIFY_UV
  void SurfacesVertexModifyUV(inout SurfacesStandardVertexIntermediate In) {
    In.texCoord = vec2(In.position.x, -In.position.z);
  }
}%

CCProgram landscape-surface %{
  #if __VERSION__ >= 300
    uniform sampler2DArray normalRoughnessAOMap;
    flat in vec4 v_tileParams;
  #endif
  #if __VERSION__ >= 300
    flat in float v_lod;
  #else
    in float v_lod;
  #endif

  vec3 lodPalette(int lod) {
    if (lod == 0) return vec3(1.00, 0.15, 0.15);
    if (lod == 1) return vec3(0.15, 0.90, 0.20);
    if (lod == 2) return vec3(0.20, 0.45, 1.00);
    if (lod == 3) return vec3(1.00, 0.90, 0.10);
    if (lod == 4) return vec3(1.00, 0.15, 0.90);
    return vec3(0.10, 0.90, 0.95);
  }

  #include <surfaces/data-structures/standard>
  #define CC_SURFACES_FRAGMENT_MODIFY_SHARED_DATA
  void SurfacesFragmentModifySharedData(inout SurfacesMaterialData surfaceData) {
    vec3 albedo = vec3(0.0);
    vec3 detailNormal = vec3(0.0, 0.0, 1.0);
    float roughness = 1.0;
    float ao = 1.0;
  #if __VERSION__ >= 300
    uvec4 packed;
    vec4 spatialWeights;
    vec2 uv = FSInput_texcoord;
    landscapeSplatSamples(vec2(uv.x, -uv.y), v_tileParams, packed, spatialWeights);
    int layers[8];
    float weights[8];
    for (int i = 0; i < 4; ++i) {
      uint value = packed[i];
      float blend = float(value >> 10u) / 63.0;
      layers[i * 2] = int(value & 31u);
      layers[i * 2 + 1] = int((value >> 5u) & 31u);
      weights[i * 2] = spatialWeights[i] * (1.0 - blend);
      weights[i * 2 + 1] = spatialWeights[i] * blend;
    }
    // Merge repeated IDs before texture sampling (usually only 2-3 unique layers).
    for (int i = 1; i < 8; ++i) {
      for (int j = 0; j < i; ++j) {
        if (layers[j] == layers[i]) {
          weights[j] += weights[i];
          weights[i] = 0.0;
          break;
        }
      }
    }
    // Explicit gradients remain valid inside the per-pixel layer branches.
    vec2 uvDx = dFdx(uv);
    vec2 uvDy = dFdy(uv);
    detailNormal = vec3(0.0);
    roughness = 0.0;
    ao = 0.0;
    for (int i = 0; i < 8; ++i) {
      if (weights[i] > 0.0) {
        float tiling = detailParams[layers[i]].x;
        vec3 coord = vec3(uv * tiling, float(layers[i]));
        vec4 ah = textureGrad(albedoHeightMap, coord, uvDx * tiling, uvDy * tiling);
        vec4 nra = textureGrad(normalRoughnessAOMap, coord, uvDx * tiling, uvDy * tiling);
        vec2 xy = nra.rg * 2.0 - 1.0;
        vec3 normal = normalize(vec3(xy, sqrt(max(1.0 - dot(xy, xy), 0.0))));
        albedo += SRGBToLinear(ah.rgb) * weights[i];
        detailNormal += normal * weights[i];
        roughness += nra.b * weights[i];
        ao += nra.a * weights[i];
      }
    }
    detailNormal = normalize(detailNormal);
  #endif
    surfaceData.baseColor = vec4(albedo * mainColor.rgb, 1.0);
    // Only RG carries the normal. B is roughness; A is linear AO.
    vec3 normal = normalize(FSInput_worldNormal);
    vec3 tangent = normalize(FSInput_worldTangent - normal * dot(normal, FSInput_worldTangent));
    surfaceData.worldNormal = normalize(CalculateNormalFromTangentSpace(detailNormal, 1.0,
      normal, tangent, FSInput_mirrorNormal));
    surfaceData.roughness = roughness;
    surfaceData.ao = ao;
    surfaceData.metallic = 0.0;
    surfaceData.specularIntensity = 0.5;
    surfaceData.emissive = vec3(0.0);

    if (terrainParams.z > 0.5) {
      surfaceData.baseColor.rgb = lodPalette(int(mod(v_lod, 6.0)));
    }
    if (terrainParams.w > 0.5) {
      float d = distance(morphCameraPos.xyz, FSInput_worldPos);
      float width = fwidth(d) * 1.5;
      for (int i = 0; i < 6; ++i) {
        if (abs(d - lodMorph[i].x) < width) surfaceData.baseColor.rgb = mix(lodPalette(i), vec3(0.95), 0.62);
        if (abs(d - lodMorph[i].y) < width) surfaceData.baseColor.rgb = lodPalette(i) * 0.45;
      }
    }
  }
}%

CCProgram landscape-vs %{
  precision highp float;
  precision highp int;
  #include <landscape-macros>
  #include <surfaces/includes/common-vs>
  #include <landscape-uniforms>
  #include <landscape-splat>
  #include <landscape-vertex>
  #include <surfaces/includes/standard-vs>
  #include <shading-entries/main-functions/render-to-scene/vs>
}%

CCProgram landscape-fs %{
  precision highp float;
  precision highp int;
  #include <landscape-macros>
  #include <surfaces/includes/common-fs>
  #include <landscape-uniforms>
  #include <landscape-splat>
  #include <landscape-surface>
  #include <lighting-models/includes/standard>
  #include <surfaces/includes/standard-fs>
  #include <shading-entries/main-functions/render-to-scene/fs>
}%

CCProgram landscape-shadow-vs %{
  precision highp float;
  precision highp int;
  #include <landscape-macros>
  #include <surfaces/effect-macros/render-to-shadowmap>
  #include <surfaces/includes/common-vs>
  #include <landscape-uniforms>
  #include <landscape-splat>
  #include <landscape-vertex>
  #include <shading-entries/main-functions/render-to-shadowmap/vs>
}%

CCProgram landscape-shadow-fs %{
  precision highp float;
  precision highp int;
  #include <surfaces/effect-macros/render-to-shadowmap>
  #include <surfaces/includes/common-fs>
  #include <landscape-uniforms>
  #include <shading-entries/main-functions/render-to-shadowmap/fs>
}%
