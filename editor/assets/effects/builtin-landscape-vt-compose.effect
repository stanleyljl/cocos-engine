// Copyright (c) 2024 Xiamen Yaji Software Co., Ltd.
// Linear material composition only: no camera, lighting, fog or tone mapping.
CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: vt-compose-vs:vert
      frag: vt-compose-fs
      depthStencilState:
        depthTest: false
        depthWrite: false
      rasterizerState:
        cullMode: none
      blendState:
        targets:
        - blend: false
        - blend: false
      properties:
        vtLayout: { value: [4096, 128, 4, 1] }
        sourceParams: { value: [129, 0, 0, 0] }
        detailParams: { value: [0.1, 0, 0, 0] }
        splatmap: { sampler: { minFilter: point, magFilter: point, addressU: clamp, addressV: clamp, addressW: clamp } }
        albedoHeightMap: { sampler: { minFilter: linear, magFilter: linear, mipFilter: linear, addressU: wrap, addressV: wrap } }
        normalRoughnessAOMap: { sampler: { minFilter: linear, magFilter: linear, mipFilter: linear, addressU: wrap, addressV: wrap } }
}%

CCProgram vt-compose-uniforms %{
  uniform Constants {
    vec4 vtLayout; // atlas size, slot size, border, texture-to-clip Y sign
    vec4 sourceParams;
    vec4 detailParams[32];
  };
}%

CCProgram vt-compose-vs %{
  precision highp float;
  #include <vt-compose-uniforms>
  in vec3 a_position;
  in vec4 a_vtPage;
  in vec4 a_vtRegion;
  in vec4 a_vtSource;
  out vec2 v_localXZ;
  #if __VERSION__ >= 300
  flat out vec4 v_source;
  #else
  out vec4 v_source;
  #endif

  vec4 vert() {
    float count = vtLayout.x / vtLayout.y;
    vec2 slot = vec2(mod(a_vtPage.x, count), floor(a_vtPage.x / count));
    vec2 atlasUv = (slot * vtLayout.y + a_position.xz * vtLayout.y) / vtLayout.x;
    // The border evaluates real neighboring coordinates rather than duplicating
    // edge pixels. Interior uv=0/1 lies on the corresponding node boundary.
    vec2 local = (a_position.xz * vtLayout.y - vtLayout.z) / (vtLayout.y - 2.0 * vtLayout.z);
    v_localXZ = a_vtRegion.xy + local * a_vtRegion.z;
    v_source = a_vtSource;
    vec2 clipPos = atlasUv * 2.0 - 1.0;
    // Texture-to-clip conversion: screenSpaceSignY * clipSpaceSignY.
    // Vulkan/GLES use +1; Metal needs -1. A screen-space flip alone is wrong.
    clipPos.y *= vtLayout.w;
    return vec4(clipPos, 0.0, 1.0);
  }
}%

CCProgram vt-compose-fs %{
  precision highp float;
  precision highp int;
  #include <vt-compose-uniforms>
  #include <common/color/gamma>
  #if __VERSION__ >= 300
  uniform highp usampler2DArray splatmap;
  uniform sampler2DArray albedoHeightMap;
  uniform sampler2DArray normalRoughnessAOMap;
  in vec2 v_localXZ;
  flat in vec4 v_source;
  layout(location = 0) out vec4 albedoOut;
  layout(location = 1) out vec4 normalOut;

  void main() {
    float edge = sourceParams.x - 1.0;
    vec2 pixel = clamp((v_localXZ - v_source.xy) / v_source.z * edge, vec2(0.0), vec2(edge));
    ivec2 origin = ivec2(min(floor(pixel), vec2(edge - 1.0)));
    vec2 f = pixel - vec2(origin);
    int page = int(v_source.w);
    uvec4 packed = uvec4(texelFetch(splatmap, ivec3(origin, page), 0).r,
      texelFetch(splatmap, ivec3(origin + ivec2(1, 0), page), 0).r,
      texelFetch(splatmap, ivec3(origin + ivec2(0, 1), page), 0).r,
      texelFetch(splatmap, ivec3(origin + ivec2(1, 1), page), 0).r);
    vec4 spatialWeights = vec4((1.0-f.x)*(1.0-f.y), f.x*(1.0-f.y), (1.0-f.x)*f.y, f.x*f.y);
    int layers[8];
    float weights[8];
    for (int i = 0; i < 4; ++i) {
      float blend = float(packed[i] >> 10u) / 63.0;
      layers[i*2] = int(packed[i] & 31u);
      layers[i*2+1] = int((packed[i] >> 5u) & 31u);
      weights[i*2] = spatialWeights[i] * (1.0-blend);
      weights[i*2+1] = spatialWeights[i] * blend;
    }
    for (int i = 1; i < 8; ++i) {
      for (int j = 0; j < i; ++j) {
        if (layers[j] == layers[i]) {
          weights[j] += weights[i];
          weights[i] = 0.0;
          break;
        }
      }
    }
    vec2 uv = vec2(v_localXZ.x, -v_localXZ.y);
    vec2 uvDx = dFdx(uv);
    vec2 uvDy = dFdy(uv);
    vec3 albedo = vec3(0.0);
    vec3 normal = vec3(0.0);
    float roughness = 0.0;
    float ao = 0.0;
    for (int i = 0; i < 8; ++i) {
      if (weights[i] > 0.0) {
        float scale = detailParams[layers[i]].x;
        vec3 coord = vec3(uv * scale, float(layers[i]));
        vec4 ah = textureGrad(albedoHeightMap, coord, uvDx * scale, uvDy * scale);
        vec4 nra = textureGrad(normalRoughnessAOMap, coord, uvDx * scale, uvDy * scale);
        vec2 xy = nra.rg * 2.0 - 1.0;
        albedo += SRGBToLinear(ah.rgb) * weights[i];
        normal += normalize(vec3(xy, sqrt(max(1.0-dot(xy,xy), 0.0)))) * weights[i];
        roughness += nra.b * weights[i];
        ao += nra.a * weights[i];
      }
    }
    // Color is stored in linear space; Base Pass must not apply SRGBToLinear.
    albedoOut = vec4(albedo, 1.0);
    normalOut = vec4(normalize(normal).xy * 0.5 + 0.5, roughness, ao);
  }
  #else
  void main() { gl_FragColor = vec4(0.5, 0.5, 0.5, 1.0); }
  #endif
}%
