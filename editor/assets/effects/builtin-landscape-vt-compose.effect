// Copyright (c) 2024 Xiamen Yaji Software Co., Ltd.
// Linear material composition only: no camera, lighting, fog or tone mapping.
CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: vt-compose-vs:vert
      frag: vt-compose-fs
      depthStencilState:
        depthTest: false
        depthWrite: false
      rasterizerState:
        cullMode: none
      blendState:
        targets:
        - blend: false
        - blend: false
      properties:
        vtLayout: { value: [4224, 264, 4, 1] }
        sourceParams: { value: [129, 1, 0, 0] }
        cliffParams: { value: [0, 1, 0, 0] }
        cliffLayout: { value: [0, 0, 1, 0] }
        cliffMaterialParams: { value: [0, 1, 0, 0] }
        cliffSourceMap: { sampler: { minFilter: point, magFilter: point, mipFilter: none } }
        terrainHeightMap: { sampler: { minFilter: linear, magFilter: linear, mipFilter: none, addressU: clamp, addressV: clamp, addressW: clamp } }
        tilingParams: { value: [0.1, 0, 0, 0] }
        globalColorParams: { value: [1, 1, 0, 0] }
        heightBlendParams: { value: [1, 3, 2, 0] }
        decalRegions: { value: [0, 0, 1, 0] }
        decalParams: { value: [0, 0, 0, 0] }
        decalLayerParams: { value: [0, 0, 0, 0] }
        decalIndexMap: { sampler: { minFilter: point, magFilter: point, mipFilter: none } }
        decalAlbedoMap: { sampler: { minFilter: linear, magFilter: linear, mipFilter: linear, addressU: clamp, addressV: clamp, addressW: clamp } }
        decalNormalMap: { sampler: { minFilter: linear, magFilter: linear, mipFilter: linear, addressU: clamp, addressV: clamp, addressW: clamp } }
        globalColorMap: { value: white, sampler: { minFilter: linear, magFilter: linear, mipFilter: linear, addressU: clamp, addressV: clamp, addressW: clamp } }
        normalSourceMap: { sampler: { minFilter: point, magFilter: point, mipFilter: none } }
        terrainNormalMap: { sampler: { minFilter: linear, magFilter: linear, mipFilter: none, addressU: clamp, addressV: clamp, addressW: clamp } }
        splatmap: { sampler: { minFilter: point, magFilter: point, addressU: clamp, addressV: clamp, addressW: clamp } }
        albedoHeightMap: { sampler: { minFilter: linear, magFilter: linear, mipFilter: linear, addressU: wrap, addressV: wrap, addressW: wrap } }
        normalRoughnessAOMap: { sampler: { minFilter: linear, magFilter: linear, mipFilter: linear, addressU: wrap, addressV: wrap, addressW: wrap } }
  - name: downsample
    passes:
    - vert: vt-mip-vs:vert
      frag: vt-mip-fs
      depthStencilState:
        depthTest: false
        depthWrite: false
      rasterizerState:
        cullMode: none
      blendState:
        targets:
        - blend: false
        - blend: false
      properties:
        mipLayout: { value: [4224, 264, 0, 1] }
        sourceAlbedo: { value: white, sampler: { minFilter: point, magFilter: point, mipFilter: none, addressU: clamp, addressV: clamp, addressW: clamp } }
        sourceNormal: { value: normal, sampler: { minFilter: point, magFilter: point, mipFilter: none, addressU: clamp, addressV: clamp, addressW: clamp } }
}%

CCProgram vt-mip-uniforms %{
  uniform MipConstants {
    vec4 mipLayout; // source atlas size, source slot size, source LOD, clip Y sign
  };
}%

CCProgram vt-mip-vs %{
  precision highp float;
  #include <vt-mip-uniforms>
  in vec2 a_position;
  in vec4 a_vtPage;
  out vec2 v_pageUV;
  #if __VERSION__ >= 300
    flat out vec2 v_slot;
  #else
    out vec2 v_slot;
  #endif
  vec4 vert() {
    float count = mipLayout.x / mipLayout.y;
    v_slot = vec2(mod(a_vtPage.x, count), floor(a_vtPage.x / count));
    v_pageUV = a_position;
    vec2 clip = (v_slot + a_position) / count * 2.0 - 1.0;
    clip.y *= mipLayout.w;
    return vec4(clip, 0.0, 1.0);
  }
}%

CCProgram vt-mip-fs %{
  precision highp float;
  precision highp int;
  #include <vt-mip-uniforms>
  #if __VERSION__ >= 300
    uniform sampler2D sourceAlbedo;
    uniform sampler2D sourceNormal;
    in vec2 v_pageUV;
    flat in vec2 v_slot;
    layout(location = 0) out vec4 albedoOut;
    layout(location = 1) out vec4 normalOut;

    vec3 decodeNormal(vec4 albedo, vec4 nra) {
      return normalize(vec3(nra.r, albedo.a, nra.g) * 2.0 - 1.0);
    }
    void main() {
      // Halve the complete slot: 256+4+4 -> 128+2+2 -> 64+1+1. Integer fetches
      // cannot cross into an unrelated physical slot, even at its outer edge.
      int size = int(mipLayout.y);
      int sourceLod = int(mipLayout.z);
      ivec2 pixel = clamp(ivec2(floor(v_pageUV * float(size / 2))), ivec2(0), ivec2(size / 2 - 1));
      ivec2 origin = ivec2(v_slot) * size + pixel * 2;
      vec4 albedo = vec4(0.0);
      vec3 normal = vec3(0.0);
      vec2 roughnessAO = vec2(0.0);
      for (int y = 0; y < 2; ++y) {
        for (int x = 0; x < 2; ++x) {
          ivec2 at = origin + ivec2(x, y);
          vec4 color = texelFetch(sourceAlbedo, at, sourceLod);
          albedo += color;
          vec4 nra = texelFetch(sourceNormal, at, sourceLod);
          normal += decodeNormal(color, nra);
          roughnessAO += nra.ba;
        }
      }
      // Albedo was already converted to linear by the compose pass.
      albedoOut = albedo * 0.25;
      vec3 filteredNormal = dot(normal, normal) > 1e-10 ? normalize(normal) : vec3(0.0, 0.0, 1.0);
      albedoOut.a = filteredNormal.y * 0.5 + 0.5;
      normalOut = vec4(filteredNormal.xz * 0.5 + 0.5, roughnessAO * 0.25);
    }
  #else
    void main() { gl_FragColor = vec4(0.0); }
  #endif
}%

CCProgram vt-compose-uniforms %{
  uniform Constants {
    vec4 vtLayout; // atlas size, slot size, border, texture-to-clip Y sign
    vec4 sourceParams; // tile resolution, bake terrain normals, unused ZW
    vec4 tilingParams[32]; // repeats/m, linear mean albedo RGB
    vec4 globalColorParams; // inverse landscape width/depth, blend strength, unused
    vec4 heightBlendParams; // strength (0 = linear), weight scale, sharpness, unused
    vec4 decalRegions[128]; // config::DECAL_INSTANCE_MAX
    vec4 decalParams; // placed decal count
    vec4 decalLayerParams[8]; // X: modulate the existing terrain color for imprints
    vec4 cliffParams; // reference state: 0 pending, +1 triplanar, -1 planar; height scale/bias; override layer + 1
    vec4 cliffLayout; // landscape minimum XZ, reference tile world size, reserved
    vec4 cliffMaterialParams; // override maximum normal Y, global color influence, reserved
  };
}%

CCProgram vt-compose-vs %{
  precision highp float;
  #include <vt-compose-uniforms>
  in vec2 a_position; // Packed XZ.
  in vec4 a_vtPage;
  in vec4 a_vtRegion;
  in vec4 a_vtSource;

  out vec2 v_localXZ;
  #if __VERSION__ >= 300
  flat out vec4 v_source;
  flat out vec2 v_decalPage;
  flat out vec4 v_region;

  #else
  out vec4 v_source;
  out vec2 v_decalPage;
  #endif

  vec4 vert() {
    float count = vtLayout.x / vtLayout.y;
    vec2 slot = vec2(mod(a_vtPage.x, count), floor(a_vtPage.x / count));
    vec2 atlasUv = (slot * vtLayout.y + a_position * vtLayout.y) / vtLayout.x;
    // The border evaluates real neighboring coordinates rather than duplicating
    // edge pixels. Interior uv=0/1 lies on the corresponding node boundary.
    vec2 local = (a_position * vtLayout.y - vtLayout.z) / (vtLayout.y - 2.0 * vtLayout.z);
    v_localXZ = a_vtRegion.xy + local * a_vtRegion.z;
    v_source = a_vtSource;
    v_decalPage = a_vtPage.xy;
    #if __VERSION__ >= 300
    v_region = a_vtRegion;
    #endif
    vec2 clipPos = atlasUv * 2.0 - 1.0;
    // Texture-to-clip conversion: screenSpaceSignY * clipSpaceSignY.
    // Vulkan/GLES use +1; Metal needs -1. A screen-space flip alone is wrong.
    clipPos.y *= vtLayout.w;
    return vec4(clipPos, 0.0, 1.0);
  }
}%

CCProgram vt-compose-fs %{
  #pragma define-meta LANDSCAPE_HEIGHT_UNORM
  precision highp float;
  precision highp int;
  #include <vt-compose-uniforms>
  #include <common/color/gamma>
  #if __VERSION__ >= 300
  uniform highp usampler2DArray splatmap;
  uniform highp sampler2DArray terrainNormalMap;
  uniform highp sampler2D normalSourceMap;
  uniform highp sampler2D cliffSourceMap;
  uniform highp sampler2DArray terrainHeightMap;
  uniform highp sampler2DArray albedoHeightMap;
  uniform highp sampler2DArray normalRoughnessAOMap;
  uniform sampler2D globalColorMap;
  uniform highp sampler2DArray decalAlbedoMap;
  uniform highp sampler2DArray decalNormalMap;
  uniform sampler2D decalIndexMap;
  in vec2 v_localXZ;
  flat in vec4 v_source;
  flat in vec2 v_decalPage;
  flat in vec4 v_region;

  layout(location = 0) out vec4 albedoOut;
  layout(location = 1) out vec4 normalOut;

  float heightBlend(float weight, float height0, float height1) {
    // Delta Force (GDC 2025, slide 66). Use the same height blending at
    // every page resolution; only the height-blending setting selects linear blending.
    float amount = clamp(heightBlendParams.x, 0.0, 1.0);
    if (amount <= 0.0 || weight <= 0.0 || weight >= 1.0) return weight;
    float sharpness = mix(1.0, max(heightBlendParams.z, 1.0), amount);
    // Heights are in [0,1]. This bound preserves both pure-layer endpoints
    // continuously, even when artists reduce the weight scale.
    float scale = max(mix(1.0, heightBlendParams.y, amount), 2.0 * amount + 1.0 / sharpness);
    return clamp((amount * (height1 - height0) + (weight - 0.5) * scale)
      * sharpness + 0.5, 0.0, 1.0);
  }

  vec2 sourceUV(vec2 xz, vec4 source) {
    vec2 uv = clamp((xz - source.xy) / source.z, vec2(0.0), vec2(1.0));
    return (uv * (sourceParams.x - 1.0) + 0.5) / sourceParams.x;
  }

  vec3 sourceNormal(vec2 xz, vec4 source) {
    vec2 n = textureLod(terrainNormalMap, vec3(sourceUV(xz, source), source.w), 0.0).rg * 2.0 - 1.0;
    return normalize(vec3(n.x, sqrt(max(1.0 - dot(n, n), 0.0)), n.y));
  }

  vec3 terrainTangent(vec3 n) {
    vec3 t = vec3(n.y, -n.x, 0.0);
    return dot(t, t) > 1e-10 ? normalize(t) : vec3(1.0, 0.0, 0.0);
  }

  // Rotate a projection frame onto the terrain (shortest arc). A flat normal
  // texture must recover the terrain normal on ALL signed axes, not axis normals.
  vec3 projectionTangent(vec3 t, vec3 axis, vec3 n) {
    return normalize(t - (axis + n) * (dot(t, n) / max(1.0 + dot(axis, n), 0.001)));
  }

  void main() {
    float edge = sourceParams.x - 1.0;
    vec2 pixel = clamp((v_localXZ - v_source.xy) / v_source.z * edge, vec2(0.0), vec2(edge));
    ivec2 origin = ivec2(min(floor(pixel), vec2(edge - 1.0)));
    vec2 f = pixel - vec2(origin);
    int page = int(v_source.w);
    // Match the importer's 00->11 diagonal. Only three integer splat fetches.
    bool lowerTriangle = f.x >= f.y;
    ivec2 third = lowerTriangle ? ivec2(1, 0) : ivec2(0, 1);
    uvec3 splatSamples = uvec3(texelFetch(splatmap, ivec3(origin, page), 0).r,
      texelFetch(splatmap, ivec3(origin + third, page), 0).r,
      texelFetch(splatmap, ivec3(origin + ivec2(1, 1), page), 0).r);
    vec3 spatialWeights = lowerTriangle ? vec3(1.0-f.x, f.x-f.y, f.y)
      : vec3(1.0-f.y, f.y-f.x, f.x);
    int ids[6];
    int minId = 31;
    int maxId = 0;
    for (int i = 0; i < 3; ++i) {
      ids[i*2] = int(splatSamples[i] & 31u);
      ids[i*2+1] = int((splatSamples[i] >> 5u) & 31u);
      minId = min(minId, min(ids[i*2], ids[i*2+1]));
      maxId = max(maxId, max(ids[i*2], ids[i*2+1]));
    }
    // Offline ID fixing guarantees <=3 distinct IDs across these six entries.
    // Extract min/mid/max without pixel-dependent top-three weight selection.
    int midId = minId;
    for (int i = 0; i < 6; ++i) {
      if (ids[i] < maxId) midId = max(midId, ids[i]);
    }
    int layers[3];
    layers[0] = minId;
    layers[1] = midId;
    layers[2] = maxId;
    int sampleIndices[6];
    float weights[3];
    vec4 albedoHeights[3];
    for (int i = 0; i < 3; ++i) {
      weights[i] = 0.0;
      albedoHeights[i] = vec4(0.0);
    }
    for (int i = 0; i < 6; ++i) {
      sampleIndices[i] = ids[i] == minId ? 0 : (ids[i] == maxId ? 2 : 1);
    }
    for (int i = 0; i < 3; ++i) {
      float blend = float(splatSamples[i] >> 10u) / 63.0;
      weights[sampleIndices[i*2]] += spatialWeights[i] * (1.0-blend);
      weights[sampleIndices[i*2+1]] += spatialWeights[i] * blend;
    }
    vec3 shadingNormal = vec3(0.0, 1.0, 0.0);
    if (sourceParams.y > 0.5) {
      ivec2 cell = clamp(ivec2(floor((v_localXZ - v_region.xy) / v_region.z * 2.0)) + ivec2(1), ivec2(0), ivec2(3));
      vec4 source = texelFetch(normalSourceMap, ivec2(cell.y * 4 + cell.x, int(v_decalPage.x)), 0);
      shadingNormal = sourceNormal(v_localXZ, source);
    }
    vec3 referenceNormal = shadingNormal;
    vec3 position = vec3(v_localXZ.x, 0.0, v_localXZ.y);
    vec3 axisWeights = vec3(0.0, 1.0, 0.0);
    if (abs(cliffParams.x) > 0.5) {
      ivec2 cell = clamp(ivec2(floor((v_localXZ - cliffLayout.xy) / cliffLayout.z)),
          ivec2(0), textureSize(cliffSourceMap, 0) - ivec2(1));
      vec4 source = texelFetch(cliffSourceMap, cell, 0);
      // Unlike geometry/normal LOD sources, this reference never changes with
      // camera distance. Decode the format selected by TilePagePool.
      vec2 h = textureLod(terrainHeightMap, vec3(sourceUV(v_localXZ, source), source.w), 0.0).rg;
      #if LANDSCAPE_HEIGHT_UNORM
      position.y = h.r * cliffParams.y + cliffParams.z;
      #else
      position.y = dot(h, vec2(256.0, 1.0)) / 257.0 * cliffParams.y + cliffParams.z;
      #endif
      referenceNormal = sourceNormal(v_localXZ, source);
      if (sourceParams.y < 0.5) shadingNormal = referenceNormal;
      float cliff = 1.0 - smoothstep(0.55, 0.8, referenceNormal.y);
      axisWeights = pow(abs(referenceNormal), vec3(4.0)) * vec3(cliff, 1.0, cliff);
      // Skip negligible projections in the VT pass. Flat ground uses one pair
      // of material samples; slopes usually need two, corner cases at most three.
      axisWeights *= step(vec3(0.001), axisWeights);
      axisWeights /= max(dot(axisWeights, vec3(1.0)), 0.00001);
    }
    if (cliffParams.x < 0.5) axisWeights = vec3(0.0, 1.0, 0.0);
    // Asset-defined slope coverage is independent of projection mode.
    bool useCliffMaterial = abs(cliffParams.x) > 0.5 && cliffParams.w > 0.0 && referenceNormal.y < cliffMaterialParams.x;
    if (useCliffMaterial) {
      layers[0] = int(cliffParams.w) - 1;
      for (int i = 0; i < 3; ++i) weights[i] = i == 0 ? 1.0 : 0.0;
      for (int i = 0; i < 6; ++i) sampleIndices[i] = 0;
    }
    bool contributing[3];
    for (int i = 0; i < 3; ++i) contributing[i] = weights[i] > 0.0;
    vec3 positionDx = dFdx(position), positionDy = dFdy(position);
    vec3 frameTangent = terrainTangent(shadingNormal);
    vec3 frameBitangent = cross(shadingNormal, frameTangent);
    vec3 albedo = vec3(0.0);
    vec3 meanAlbedo = vec3(0.0);
    vec3 normal = vec3(0.0);
    float roughness = 0.0;
    float ao = 0.0;
    for (int projection = 0; projection < 3; ++projection) {
      float axisWeight = axisWeights[projection];
      if (axisWeight <= 0.0) continue;
      vec2 uv = vec2(position.x, -position.z);
      vec2 uvDx = vec2(positionDx.x, -positionDx.z);
      vec2 uvDy = vec2(positionDy.x, -positionDy.z);
      vec3 tangent = frameTangent;
      if (projection == 0) {
        float direction = referenceNormal.x < 0.0 ? -1.0 : 1.0;
        uv = vec2(-direction * position.z, position.y);
        uvDx = vec2(-direction * positionDx.z, positionDx.y);
        uvDy = vec2(-direction * positionDy.z, positionDy.y);
        tangent = projectionTangent(vec3(0.0, 0.0, -direction), vec3(direction, 0.0, 0.0), shadingNormal);
      } else if (projection == 2) {
        float direction = referenceNormal.z < 0.0 ? -1.0 : 1.0;
        uv = vec2(direction * position.x, position.y);
        uvDx = vec2(direction * positionDx.x, positionDx.y);
        uvDy = vec2(direction * positionDy.x, positionDy.y);
        tangent = projectionTangent(vec3(direction, 0.0, 0.0), vec3(0.0, 0.0, direction), shadingNormal);
      }
      // Fetch each contributing material's color/height once. Pure endpoints
      // cannot acquire a previously absent layer during height blending.
      for (int i = 0; i < 3; ++i) {
        if (contributing[i]) {
          float scale = tilingParams[layers[i]].x;
          vec3 coord = vec3(uv * scale, float(layers[i]));
          albedoHeights[i] = textureGrad(albedoHeightMap, coord, uvDx * scale, uvDy * scale);
        }
        weights[i] = 0.0;
      }
      // Apply height blending to each original pair BEFORE spatial interpolation.
      // Shared vertex pairs agree across triangle edges and imported tile borders.
      for (int i = 0; i < 3; ++i) {
        int bottom = sampleIndices[i*2];
        int top = sampleIndices[i*2+1];
        float blend = float(splatSamples[i] >> 10u) / 63.0;
        if (bottom != top && spatialWeights[i] > 0.0) {
          blend = heightBlend(blend, albedoHeights[bottom].a, albedoHeights[top].a);
        }
        weights[bottom] += spatialWeights[i] * (1.0-blend);
        weights[top] += spatialWeights[i] * blend;
      }
      for (int i = 0; i < 3; ++i) {
        if (weights[i] > 0.0) {
          float scale = tilingParams[layers[i]].x;
          vec3 coord = vec3(uv * scale, float(layers[i]));
          vec4 ah = albedoHeights[i];
          vec4 nra = textureGrad(normalRoughnessAOMap, coord, uvDx * scale, uvDy * scale);
          vec2 xy = nra.rg * 2.0 - 1.0;
          albedo += SRGBToLinear(ah.rgb) * (weights[i] * axisWeight);
          meanAlbedo += tilingParams[layers[i]].yzw * (weights[i] * axisWeight);
          vec3 detail = normalize(vec3(xy, sqrt(max(1.0-dot(xy,xy), 0.0))));
          vec3 localNormal = tangent * detail.x + cross(shadingNormal, tangent) * detail.y + shadingNormal * detail.z;
          normal += localNormal * (weights[i] * axisWeight);
          roughness += nra.b * (weights[i] * axisWeight);
          ao += nra.a * (weights[i] * axisWeight);
        }
      }
    }
    // Decals retain their existing terrain tangent-space convention, including
    // when cached normals are disabled. Only the final output encoding depends on that setting.
    normal = vec3(dot(normal, frameTangent), dot(normal, frameBitangent), dot(normal, shadingNormal));
    // Source image rows run along +Z, just like height/splat tiles. This map
    // covers the whole landscape once, including all VT pages and their borders.
    float globalColorStrength = globalColorParams.z * (useCliffMaterial ? cliffMaterialParams.y : 1.0);
    if (globalColorStrength > 0.0) {
      vec2 globalUV = v_localXZ * globalColorParams.xy + vec2(0.5);
      vec3 globalColor = SRGBToLinear(texture(globalColorMap, globalUV).rgb);
      vec3 detail = clamp(albedo / max(meanAlbedo, vec3(0.02)), vec3(0.25), vec3(4.0));
      albedo = mix(albedo, globalColor * detail, globalColorStrength);
    }
    // Static planar decal composition is cached in RVT. Explicit gradients
    // remain valid at coverage boundaries and while a page is being refined.
    vec2 decalDx = dFdx(v_localXZ), decalDy = dFdy(v_localXZ);
    for (int entry = 0; entry < 128; ++entry) {
      if (entry >= int(v_decalPage.y)) break;
      vec4 indices = texelFetch(decalIndexMap, ivec2(entry / 4, int(v_decalPage.x)), 0);
      int i = int(indices[entry % 4] * 255.0 + 0.5);
      vec4 region = decalRegions[i];
      vec2 decalUV = (v_localXZ - region.xy) / region.z;
      // Half-open footprints give adjoining decal regions one owner at seams.
      if (any(lessThan(decalUV, vec2(0.0))) || any(greaterThanEqual(decalUV, vec2(1.0)))) continue;
      vec3 coord = vec3(decalUV, region.w);
      vec4 color = textureGrad(decalAlbedoMap, coord, decalDx / region.z, decalDy / region.z);
      if (color.a <= 0.0) continue;
      vec4 nra = textureGrad(decalNormalMap, coord, decalDx / region.z, decalDy / region.z);
      vec4 layer = decalLayerParams[int(region.w)];
      if (layer.y > 0.0 && layer.z > 0.0) {
        // The low-resolution decal stores coverage and a blend mask only.
        // Repeated source materials keep their own texel density in every VT page.
        int a = int(layer.y) - 1, b = int(layer.z) - 1;
        vec2 local = v_localXZ - region.xy;
        float scaleA = tilingParams[a].x, scaleB = tilingParams[b].x;
        vec3 uvA = vec3(local * scaleA, float(a)), uvB = vec3(local * scaleB, float(b));
        vec4 ca = textureGrad(albedoHeightMap, uvA, decalDx * scaleA, decalDy * scaleA);
        vec4 cb = textureGrad(albedoHeightMap, uvB, decalDx * scaleB, decalDy * scaleB);
        vec4 na = textureGrad(normalRoughnessAOMap, uvA, decalDx * scaleA, decalDy * scaleA);
        vec4 nb = textureGrad(normalRoughnessAOMap, uvB, decalDx * scaleB, decalDy * scaleB);
        float weight = nra.b;
        color.rgb = mix(ca.rgb * ca.rgb, cb.rgb * cb.rgb, weight) * color.a;
        nra = mix(na, nb, weight);
      }
      vec2 xy = nra.rg * 2.0 - 1.0;
      vec3 decalNormal = normalize(vec3(xy, sqrt(max(1.0 - dot(xy, xy), 0.0))));
      // Imprints darken the existing material rather than painting a solid
      // shoe-shaped brown patch. The stored source is premultiplied linear RGB.
      vec3 over = albedo * (1.0 - color.a) + color.rgb;
      vec3 modulated = albedo * (vec3(1.0 - color.a) + color.rgb);
      albedo = mix(over, modulated, layer.x);
      normal = normalize(mix(normalize(normal), decalNormal, color.a));
      roughness = mix(roughness, nra.b, color.a);
      ao = mix(ao, nra.a, color.a);
    }
    normal = normalize(normal);
    if (sourceParams.y > 0.5) {
      normal = normalize(frameTangent * normal.x + frameBitangent * normal.y + shadingNormal * normal.z);
    }
    // Three signed components filter continuously, even when the composed
    // normal points below the horizon. Reuse the otherwise unused albedo alpha.
    // OFF stores tangent space; ON stores terrain-local space. All pages are
    // invalidated together when this convention changes.
    albedoOut = vec4(albedo, normal.y * 0.5 + 0.5);
    normalOut = vec4(normal.xz * 0.5 + 0.5, roughness, ao);
  }
  #else
  void main() { gl_FragColor = vec4(0.5, 0.5, 0.5, 1.0); }
  #endif
}%
