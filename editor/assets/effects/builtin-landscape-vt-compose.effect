// Copyright (c) 2024 Xiamen Yaji Software Co., Ltd.
// Landscape VT page compose (M9b). A dedicated ortho "compose camera" renders
// this material into the VT physical-atlas RenderTexture. The compose Model has
// one instanced quad per atlas page slot; each active instance positions its quad
// over its page rect (via a_composeInst) and the fragment shader composes that
// Node's albedo from its splat tile + the material library (up to 8 materials via
// 2 ids/texel x 4-neighbor blend). Unused slots output a degenerate (clipped) quad.
CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: vt-compose-vs:vert
      frag: vt-compose-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      rasterizerState:
        cullMode: none
}%

CCProgram vt-compose-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  #if USE_INSTANCING
    // x = page slot index, y = splat page-pool layer, z = splat UV scale (ancestor
    // fallback), w = active (0 => unused slot, output a clipped quad).
    in vec4 a_composeInst;
    // x = splat UV offset X, y = splat UV offset Z.
    in vec4 a_composeInst2;
  #endif

  out vec2 v_splatUv;
  out vec2 v_matUv;
  out float v_splatLayer;

  const float PAGES_PER_SIDE = 32.0;  // must match config::VT_PAGES_PER_SIDE
  const float TILING_METERS = 8.0;    // material texture repeats every N meters (world-consistent across LOD)

  vec4 vert () {
    vec4 position;
    CCVertInput(position);
    vec2 local = position.xz; // [0,1] within the page
  #if USE_INSTANCING
    if (a_composeInst.w < 0.5) {
      return vec4(2.0, 2.0, 2.0, 1.0); // unused slot: fully clipped, composes nothing
    }
    float slot = a_composeInst.x;
    float px = mod(slot, PAGES_PER_SIDE);
    float py = (PAGES_PER_SIDE - 1.0) - floor(slot / PAGES_PER_SIDE); // slot 0 = top row (free pages stay at the bottom)
    vec2 atlasUv = (vec2(px, py) + local) / PAGES_PER_SIDE;
    v_splatUv = local * a_composeInst.z + vec2(a_composeInst2.x, a_composeInst2.y);
    v_matUv = local * (a_composeInst2.z / TILING_METERS); // world-space material tiling
    v_splatLayer = a_composeInst.y;
    return vec4(atlasUv * 2.0 - 1.0, 0.0, 1.0);
  #else
    v_splatUv = local;
    v_matUv = local;
    v_splatLayer = 0.0;
    return vec4(local * 2.0 - 1.0, 0.0, 1.0);
  #endif
  }
}%

CCProgram vt-compose-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <legacy/output>

  #if __VERSION__ >= 300
    uniform usampler2DArray splatPages;
    uniform sampler2DArray materialAlbedo;
  #endif

  in vec2 v_splatUv;
  in vec2 v_matUv;
  in float v_splatLayer;

  const float SPLAT_RES = 129.0; // splat tile resolution (config::TILE_RESOLUTION)
  // The atlas page (128^2) is later minified by the terrain, which samples the
  // atlas WITHOUT mips. So bake a band-limited page here: bias the material
  // mip up a bit (uses the material library's mipmaps) so the page has no
  // high-frequency detail left to alias into black speckles when minified.
  const float MATERIAL_MIP_BIAS = 1.5;

  vec3 materialColor (float id, vec2 uv) {
  #if __VERSION__ >= 300
    return texture(materialAlbedo, vec3(uv, id), MATERIAL_MIP_BIAS).rgb;
  #else
    return vec3(0.5);
  #endif
  }

  // Splat texel = two material ids (5 bits each) + upper-layer weight (6 bits).
  // Bilinear over the 4 neighbor texels blends up to 8 materials per pixel.
  vec3 blendSplatAlbedo (vec2 uv, vec2 matUv) {
  #if __VERSION__ >= 300
    vec2 texel = uv * SPLAT_RES - 0.5;
    vec2 base = floor(texel);
    vec2 f = texel - base;
    vec3 albedo = vec3(0.0);
    for (int j = 0; j < 2; ++j) {
      for (int i = 0; i < 2; ++i) {
        vec2 cell = (base + vec2(float(i), float(j)) + 0.5) / SPLAT_RES;
        uint s = texture(splatPages, vec3(clamp(cell, vec2(0.0), vec2(1.0)), v_splatLayer)).r;
        float id0 = float(s & 31u);
        float id1 = float((s >> 5u) & 31u);
        float w = float((s >> 10u) & 63u) / 63.0;
        vec3 c = mix(materialColor(id0, matUv), materialColor(id1, matUv), w);
        float bw = (i == 0 ? 1.0 - f.x : f.x) * (j == 0 ? 1.0 - f.y : f.y);
        albedo += c * bw;
      }
    }
    return albedo;
  #else
    return vec3(0.5);
  #endif
  }

  vec4 frag () {
    return CCFragOutput(vec4(blendSplatAlbedo(v_splatUv, v_matUv), 1.0));
  }
}%
